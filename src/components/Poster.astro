---
// Pure visual poster piece: color field + grain + genre/title overlay.
// This is the "placeholder" treatment from the poster provider — swap in a
// real <img> here once posters.ts returns real photography, keeping the
// shade/overlay so titles stay legible over any image.
interface Props {
  title: string;
  genre?: string;
  color?: string;
  size?: 'md' | 'lg' | 'fill';
  // Skip the built-in shade/genre/title overlay — use when the caller
  // provides its own caption (e.g. the hero's custom badge + credit line).
  bare?: boolean;
}

const { title, genre, color = '#3A3A38', size = 'md', bare = false } = Astro.props;
---

<div class:list={['poster', size]} style={`--c1:${color}`}>
  <div class="grain"></div>
  {!bare && (
    <>
      <div class="poster-shade"></div>
      {genre && <span class="poster-genre">{genre}</span>}
      <h3 class="poster-title">{title}</h3>
    </>
  )}
</div>

<style>
  .poster {
    position: relative;
    overflow: hidden;
    border-radius: 3px;
    isolation: isolate;
    aspect-ratio: 2 / 3;
    background: linear-gradient(155deg, var(--c1), color-mix(in srgb, var(--c1) 55%, black) 80%);
  }
  .poster::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse 90% 65% at 26% 10%, rgba(255,255,255,.18), transparent 60%);
  }
  .poster-shade {
    position: absolute;
    inset: auto 0 0 0;
    height: 55%;
    background: linear-gradient(to top, rgba(0,0,0,.58), transparent);
    z-index: 1;
  }
  .poster-genre {
    position: absolute;
    left: 14px;
    bottom: 58px;
    z-index: 2;
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .04em;
    color: rgba(255,255,255,.72);
    text-transform: uppercase;
  }
  .poster-title {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 14px;
    z-index: 2;
    font-family: var(--font-serif);
    font-weight: 560;
    font-size: 1.18rem;
    line-height: 1.02;
    color: #FBF8EF;
  }
  .poster.lg .poster-title {
    font-size: 1.5rem;
  }

  .poster.fill {
    aspect-ratio: auto;
    height: 100%;
    border-radius: 0;
  }
</style>
