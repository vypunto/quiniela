---
interface Showtime {
  time: string;
  language?: string;
  price?: string;
  format?: string;
  url?: string;
}

interface Props {
  cinemaName: string;
  cinemaSlug?: string;
  distance: string;
  showtimes: Showtime[];
  website?: string;
}

const { cinemaName, cinemaSlug, distance, showtimes = [], website } = Astro.props;
const buyUrl = showtimes.find(st => st.url)?.url || website;
---

<div class="cinema-row">
  <div>
    {cinemaSlug
      ? <a href={`/cine/${cinemaSlug}`} class="cinema-name">{cinemaName}</a>
      : <span class="cinema-name">{cinemaName}</span>}
    <div class="cinema-dist">{distance}</div>
  </div>

  {buyUrl && (
    <a href={buyUrl} class="btn-buy" target="_blank" rel="noopener noreferrer">
      Comprar
      <svg class="arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
      <span class="wipe"></span>
    </a>
  )}

  {showtimes.length > 0 && (
    <div class="showtimes">
      {showtimes.map((st) => (
        <span class="showtime">
          <span class="t">{st.time}</span>
          {st.language && <span class="tag">{st.language}</span>}
          {st.format && st.format !== '2D' && <span class="tag">{st.format}</span>}
          {st.price && <span class="price">{st.price}</span>}
        </span>
      ))}
    </div>
  )}

  {!buyUrl && showtimes.length > 0 && (
    <p class="no-link-note">Sesión sin enlace de compra disponible.</p>
  )}
</div>

<style>
  .cinema-row {
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-border-alt);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px var(--space-4);
  }

  .cinema-row:last-child {
    border-bottom: 1px solid var(--color-border-alt);
  }

  .cinema-name {
    font-size: 1.14rem;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  a.cinema-name:hover {
    color: var(--color-text-secondary);
  }

  .cinema-dist {
    font-size: .84rem;
    font-weight: 500;
    color: var(--color-text-tertiary);
    margin-top: 5px;
  }

  .showtimes {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 10px var(--space-8);
    margin-top: var(--space-4);
    font-variant-numeric: tabular-nums;
  }

  .showtime {
    display: flex;
    align-items: baseline;
    gap: 9px;
  }

  .t {
    font-size: 1.14rem;
    font-weight: 800;
    color: var(--color-text);
  }

  .tag {
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .04em;
    color: var(--color-text-tertiary);
    text-transform: uppercase;
  }

  .price {
    font-size: .9rem;
    font-weight: 700;
    color: var(--color-text-secondary);
  }

  .no-link-note {
    grid-column: 1 / -1;
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    margin-top: var(--space-2);
    margin-bottom: 0;
  }
</style>
