---
interface Showtime {
  time: string;
  language?: string;
  price?: string;
  format?: string;
  url?: string;
}

interface Props {
  cinemaName: string;
  distance: string;
  showtimes: Showtime[];
  website?: string;
}

const { cinemaName, distance, showtimes = [], website } = Astro.props;
---

<div class="cinema-result">
  <div class="cinema-header">
    <h3 class="cinema-name">{cinemaName}</h3>
    <span class="cinema-distance">{distance}</span>
  </div>

  {showtimes.length > 0 && (
    <div class="showtimes-grid">
      {showtimes.map((st) => (
        <a
          href={st.url || website || '#'}
          class="showtime-chip"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="showtime-time">{st.time}</span>
          {st.language && <span class="showtime-meta">{st.language}</span>}
          {st.price && <span class="showtime-price">{st.price}</span>}
        </a>
      ))}
    </div>
  )}

  {website && (
    <a href={website} class="buy-link" target="_blank" rel="noopener noreferrer">
      COMPRAR <span aria-hidden="true">&rarr;</span>
    </a>
  )}
</div>

<style>
  .cinema-result {
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
  }

  .cinema-result:last-child {
    border-bottom: none;
  }

  .cinema-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-3);
  }

  .cinema-name {
    font-size: var(--text-base);
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .cinema-distance {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .showtimes-grid {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-3);
  }

  .showtime-chip {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-bg);
    color: var(--color-text);
    text-decoration: none;
    transition: background-color var(--transition-fast), border-color var(--transition-fast);
  }

  .showtime-chip:hover {
    background-color: var(--color-accent-subtle);
    border-color: var(--color-accent);
    color: var(--color-text);
  }

  .showtime-time {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  .showtime-meta {
    color: var(--color-text-tertiary);
    font-size: var(--text-xs);
  }

  .showtime-meta::before {
    content: '\00b7';
    margin-right: var(--space-1);
  }

  .showtime-price {
    color: var(--color-text-secondary);
    font-size: var(--text-xs);
  }

  .showtime-price::before {
    content: '\00b7';
    margin-right: var(--space-1);
  }

  .buy-link {
    display: inline-block;
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .buy-link:hover {
    color: var(--color-text);
  }
</style>
