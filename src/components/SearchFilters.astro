---
---

<div class="search-filters" role="group" aria-label="Filtros de busqueda">
  <div class="filter-row">
    <span class="filter-label">Idioma</span>
    <div class="filter-chips" data-filter="language">
      <button type="button" class="filter-chip active" data-value="all" aria-pressed="true">Todos</button>
      <button type="button" class="filter-chip" data-value="castellano" aria-pressed="false">Castellano</button>
      <button type="button" class="filter-chip" data-value="vo" aria-pressed="false">VO</button>
      <button type="button" class="filter-chip" data-value="vose" aria-pressed="false">VOSE</button>
    </div>
  </div>

  <div class="filter-row">
    <span class="filter-label">Formato</span>
    <div class="filter-chips" data-filter="format">
      <button type="button" class="filter-chip active" data-value="all" aria-pressed="true">Todos</button>
      <button type="button" class="filter-chip" data-value="2d" aria-pressed="false">2D</button>
      <button type="button" class="filter-chip" data-value="3d" aria-pressed="false">3D</button>
      <button type="button" class="filter-chip" data-value="imax" aria-pressed="false">IMAX</button>
    </div>
  </div>

  <div class="filter-row">
    <span class="filter-label">Ordenar</span>
    <div class="filter-chips" data-filter="sort">
      <button type="button" class="filter-chip active" data-value="relevancia" aria-pressed="true">Relevancia</button>
      <button type="button" class="filter-chip" data-value="cercania" aria-pressed="false">Cercania</button>
      <button type="button" class="filter-chip" data-value="hora" aria-pressed="false">Hora</button>
      <button type="button" class="filter-chip" data-value="precio" aria-pressed="false">Precio</button>
    </div>
  </div>
</div>

<script>
  const filtersContainer = document.querySelector('.search-filters')!;
  const filterState: Record<string, string> = {
    language: 'all',
    format: 'all',
    sort: 'relevancia',
  };

  filtersContainer.addEventListener('click', (e) => {
    const chip = (e.target as HTMLElement).closest('.filter-chip') as HTMLElement | null;
    if (!chip) return;

    const row = chip.closest('.filter-chips') as HTMLElement;
    const filterName = row.dataset.filter || '';

    row.querySelectorAll('.filter-chip').forEach(el => {
      el.classList.remove('active');
      el.setAttribute('aria-pressed', 'false');
    });
    chip.classList.add('active');
    chip.setAttribute('aria-pressed', 'true');

    filterState[filterName] = chip.dataset.value || 'all';

    filtersContainer.dispatchEvent(
      new CustomEvent('filterchange', { bubbles: true, detail: { ...filterState } })
    );
  });
</script>

<style>
  .search-filters {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-4) 0;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  .filter-row {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .filter-label {
    font-size: var(--text-xs);
    font-weight: 500;
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    min-width: 56px;
    flex-shrink: 0;
  }

  .filter-chips {
    display: flex;
    gap: var(--space-1);
    flex-wrap: wrap;
  }

  .filter-chip {
    padding: var(--space-1) var(--space-3);
    font-size: var(--text-sm);
    border-radius: var(--radius-full);
    border: 1px solid transparent;
    background-color: transparent;
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: background-color var(--transition-fast), color var(--transition-fast);
  }

  .filter-chip:hover {
    background-color: var(--color-accent-subtle);
    color: var(--color-text);
  }

  .filter-chip.active {
    background-color: var(--color-accent-subtle);
    color: var(--color-text);
    font-weight: 500;
  }

  @media (max-width: 480px) {
    .filter-row {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-1);
    }
  }
</style>
