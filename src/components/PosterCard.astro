---
import Poster from './Poster.astro';

interface Props {
  title: string;
  slug: string;
  rating?: number;
  genre?: string;
  posterColor?: string;
  size?: 'md' | 'lg';
}

const { title, slug, rating, genre, posterColor, size = 'md' } = Astro.props;
---

<a href={`/pelicula/${slug}`} class="poster-card">
  <Poster title={title} genre={genre} color={posterColor} size={size} />
  <div class="poster-info">
    <span class="poster-name">{title}</span>
    <span class="poster-meta">
      {rating && <span class="poster-rating">{rating.toFixed(1)}</span>}
      {genre && <span class="poster-genre-label">{genre}</span>}
    </span>
  </div>
</a>

<style>
  .poster-card {
    display: block;
    text-decoration: none;
    color: var(--color-text);
    flex-shrink: 0;
    width: 164px;
    cursor: pointer;
    transition: transform var(--transition-base);
  }

  .poster-card:hover {
    transform: translateY(-5px);
    color: var(--color-text);
  }

  .poster-info {
    margin-top: 12px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .poster-name {
    font-size: var(--text-sm);
    font-weight: 700;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .poster-meta {
    display: flex;
    align-items: center;
    gap: 4px;
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .poster-rating {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-secondary);
  }

  .poster-genre-label::before {
    content: '·';
    margin-right: 4px;
  }

  @media (min-width: 768px) {
    .poster-card {
      width: 190px;
    }
  }
</style>
