---
interface Props {
  title: string;
  slug: string;
  rating?: number;
  genre?: string;
  posterColor?: string;
  initials?: string;
}

const { title, slug, rating, genre, posterColor = '#2a2a2a', initials } = Astro.props;

const movieInitials = initials || title.split(' ').filter(w => w.length > 2 || title.split(' ').length <= 2).slice(0, 2).map(w => w[0].toUpperCase()).join('');

const posterSvg = `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 300"><rect width="200" height="300" fill="${posterColor}"/><text x="100" y="160" font-family="system-ui,sans-serif" font-size="48" font-weight="700" fill="rgba(255,255,255,0.15)" text-anchor="middle">${movieInitials}</text></svg>`)}`;
---

<a href={`/pelicula/${slug}`} class="poster-card">
  <div class="poster-frame">
    <img
      src={posterSvg}
      alt={`Póster de ${title}`}
      width="200"
      height="300"
      loading="lazy"
      class="poster-img"
    />
  </div>
  <div class="poster-info">
    <span class="poster-title">{title}</span>
    <span class="poster-meta">
      {rating && <span class="poster-rating">{rating.toFixed(1)}</span>}
      {genre && <span class="poster-genre">{genre}</span>}
    </span>
  </div>
</a>

<style>
  .poster-card {
    display: block;
    text-decoration: none;
    color: var(--color-text);
    flex-shrink: 0;
    width: 140px;
    transition: transform var(--transition-fast);
  }

  .poster-card:hover {
    transform: translateY(-4px);
    color: var(--color-text);
  }

  .poster-frame {
    aspect-ratio: 2 / 3;
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-bottom: var(--space-2);
    background-color: var(--color-surface);
  }

  .poster-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .poster-info {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .poster-title {
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .poster-meta {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
  }

  .poster-rating {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--color-text-secondary);
  }

  .poster-genre::before {
    content: '·';
    margin-right: var(--space-1);
  }

  @media (min-width: 768px) {
    .poster-card {
      width: 160px;
    }
  }
</style>
