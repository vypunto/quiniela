---
---

<div class="time-range" role="group" aria-label="Rango de horario">
  <label class="time-range-label">Horario</label>
  <div class="time-selects">
    <select id="time-from" aria-label="Hora de inicio" class="time-select">
      <!-- Options generated by JS -->
    </select>
    <span class="time-separator" aria-hidden="true">&mdash;</span>
    <select id="time-to" aria-label="Hora de fin" class="time-select">
      <!-- Options generated by JS -->
    </select>
  </div>
</div>

<script>
  function buildTimeOptions(selectEl: HTMLSelectElement, defaultValue: string) {
    const options: string[] = [];
    for (let h = 10; h <= 24; h++) {
      const hour = h === 24 ? 0 : h;
      const label0 = `${String(hour).padStart(2, '0')}:00`;
      const label30 = `${String(hour).padStart(2, '0')}:30`;
      options.push(label0);
      if (h < 24) options.push(label30);
    }

    selectEl.innerHTML = options.map(t =>
      `<option value="${t}"${t === defaultValue ? ' selected' : ''}>${t}</option>`
    ).join('');
  }

  const fromSelect = document.getElementById('time-from') as HTMLSelectElement;
  const toSelect = document.getElementById('time-to') as HTMLSelectElement;

  buildTimeOptions(fromSelect, '16:00');
  buildTimeOptions(toSelect, '23:30');
</script>

<style>
  .time-range {
    margin-bottom: var(--space-6);
  }

  .time-range-label {
    display: block;
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-bottom: var(--space-2);
  }

  .time-selects {
    display: flex;
    align-items: center;
    gap: var(--space-3);
  }

  .time-select {
    padding: var(--space-2) var(--space-3);
    font-size: var(--text-base);
    font-variant-numeric: tabular-nums;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
    transition: border-color var(--transition-fast);
    appearance: none;
    -webkit-appearance: none;
    background-image: url("data:image/svg+xml,%3Csvg width='10' height='6' viewBox='0 0 10 6' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M1 1L5 5L9 1' stroke='%23999' stroke-width='1.5' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E");
    background-repeat: no-repeat;
    background-position: right 10px center;
    padding-right: var(--space-8);
  }

  .time-select:focus {
    border-color: var(--color-accent);
  }

  .time-separator {
    color: var(--color-text-tertiary);
    font-size: var(--text-sm);
  }
</style>
