---
interface Props {
  title: string;
  subtitle?: string;
  arrows?: boolean;
  bg?: 'crema' | 'blanco';
}

const { title, subtitle, arrows = true, bg = 'crema' } = Astro.props;
const railId = `rail-${title.toLowerCase().replace(/[^a-z0-9]+/g, '-')}`;
---

<section class:list={['poster-rail', { 'bg-white': bg === 'blanco' }]}>
  <div class="rail-head">
    <div>
      <span class="mark" aria-hidden="true"></span>
      <h2 class="rail-title">{title}</h2>
      {subtitle && <p class="rail-subtitle">{subtitle}</p>}
    </div>
    {arrows && (
      <div class="rail-nav">
        <button class="rail-arrow" type="button" data-dir="-1" data-target={railId} aria-label="Anterior">
          <span class="arrow-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="15 18 9 12 15 6"></polyline></svg></span>
          <span class="wipe"></span>
        </button>
        <button class="rail-arrow" type="button" data-dir="1" data-target={railId} aria-label="Siguiente">
          <span class="arrow-icon"><svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
          <span class="wipe"></span>
        </button>
      </div>
    )}
  </div>
  <div class="rail-scroll">
    <div class="rail-track" id={railId}>
      <slot />
    </div>
  </div>
</section>

<script>
  document.querySelectorAll('.rail-arrow').forEach((btn) => {
    btn.addEventListener('click', () => {
      const dir = Number((btn as HTMLElement).dataset.dir || '1');
      const targetId = (btn as HTMLElement).dataset.target;
      const track = targetId ? document.getElementById(targetId) : null;
      track?.scrollBy({ left: dir * 260, behavior: 'smooth' });
    });
  });
</script>

<style>
  .poster-rail {
    padding: var(--space-16) 0;
  }

  .rail-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-6);
    padding: 0 var(--space-4);
    margin-bottom: var(--space-6);
    max-width: var(--container-max);
    margin-left: auto;
    margin-right: auto;
  }

  .rail-title {
    font-size: var(--text-3xl);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.06;
  }

  .rail-subtitle {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-top: var(--space-2);
    margin-bottom: 0;
  }

  .rail-nav {
    display: flex;
    gap: var(--space-2);
    flex-shrink: 0;
  }

  .rail-arrow {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    border: 1.5px solid var(--color-text);
    background: none;
    color: var(--color-text);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: color var(--transition-base);
  }

  .rail-arrow .arrow-icon {
    position: relative;
    z-index: 1;
  }

  .rail-arrow .wipe {
    position: absolute;
    inset: 0;
    background: var(--color-text);
    border-radius: 50%;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform .24s var(--ease-wipe);
    z-index: -1;
  }

  .rail-arrow:hover { color: var(--color-bg); }
  .rail-arrow:hover .wipe { transform: scaleX(1); }

  .rail-scroll {
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    scroll-snap-type: x proximity;
  }

  .rail-scroll::-webkit-scrollbar {
    display: none;
  }

  .rail-track {
    display: flex;
    gap: var(--space-3);
    padding: 0 var(--space-4) var(--space-2);
    max-width: var(--container-max);
    margin: 0 auto;
    scroll-padding-left: var(--space-4);
  }

  .rail-track :global(> *) {
    scroll-snap-align: start;
  }

  .rail-track::after {
    content: '';
    flex-shrink: 0;
    width: var(--space-4);
  }

  @media (min-width: 768px) {
    .rail-head {
      padding: 0 var(--space-8);
    }

    .rail-track {
      padding: 0 var(--space-8) var(--space-2);
      gap: var(--space-4);
      scroll-padding-left: var(--space-8);
    }
  }
</style>
