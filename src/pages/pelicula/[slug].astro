---
import Layout from '../../components/Layout.astro';
import MovieHero from '../../components/MovieHero.astro';
import MovieReview from '../../components/MovieReview.astro';
import MovieWorthIt from '../../components/MovieWorthIt.astro';
import PosterCard from '../../components/PosterCard.astro';
import CinemaResult from '../../components/CinemaResult.astro';
import { getAllMovies, getMovieBySlug, searchSessions } from '../../lib/search/searchEngine';

export function getStaticPaths() {
  const movies = getAllMovies();
  return movies.map(movie => ({
    params: { slug: movie.slug },
  }));
}

const { slug } = Astro.params;
const movie = getMovieBySlug(slug);

if (!movie) {
  return Astro.redirect('/404');
}

// Get today's date
const today = new Date();
const todayStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;

// Search sessions for this movie, Madrid center, 20km radius
const results = searchSessions({
  movieId: movie.id,
  date: todayStr,
  latitude: 40.4168,
  longitude: -3.7038,
  maxDistance: 20,
  sortBy: 'distance',
});

const cinemaResults = results[0]?.cinemaResults || [];
const totalSessions = results[0]?.totalSessions || 0;

// Duration formatting
const hours = Math.floor(movie.duration / 60);
const mins = movie.duration % 60;
const durationStr = `${hours}h ${mins}min`;

// Similar movies: same genres, excluding current
const allMovies = getAllMovies();
const similarMovies = allMovies
  .filter(m => m.id !== movie.id)
  .map(m => ({
    movie: m,
    score: m.genres.filter(g => movie.genres.includes(g)).length,
  }))
  .filter(m => m.score > 0)
  .sort((a, b) => b.score - a.score)
  .slice(0, 4)
  .map(m => m.movie);

// Editorial review categories
const categories = movie.editorialReview ? [
  { name: 'Historia', score: movie.editorialReview.scores.historia },
  { name: 'Dirección', score: movie.editorialReview.scores.direccion },
  { name: 'Visual', score: movie.editorialReview.scores.visual },
  { name: 'Entretenimiento', score: movie.editorialReview.scores.entretenimiento },
  { name: 'Banda sonora', score: movie.editorialReview.scores.bandaSonora },
] : [];

// SEO
const title = `${movie.title} — Sesiones y horarios`;
const description = `${movie.title} (${movie.year}) de ${movie.director}. ${movie.synopsis.slice(0, 140)}... Encuentra sesiones de cine en Madrid.`;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Movie',
  name: movie.title,
  director: { '@type': 'Person', name: movie.director },
  dateCreated: String(movie.year),
  duration: `PT${hours}H${mins}M`,
  genre: movie.genres,
  description: movie.synopsis,
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: movie.rating,
    bestRating: 10,
    worstRating: 0,
    ratingCount: 1,
  },
};
---

<Layout title={title} description={description} jsonLd={jsonLd}>
  <article class="movie-page container--narrow">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/">Inicio</a>
      <span aria-hidden="true">/</span>
      <span>{movie.title}</span>
    </nav>

    <MovieHero
      title={movie.title}
      year={movie.year}
      duration={durationStr}
      genre={movie.genres.join(', ')}
      director={movie.director}
      rating={movie.rating}
      country={movie.country}
      ageRating={movie.ageRating}
      synopsis={movie.synopsis}
      cast={movie.cast}
      movieId={movie.id}
    />

    {movie.editorialTags.length > 0 && (
      <div class="editorial-tags">
        {movie.editorialTags.map(tag => (
          <span class="editorial-tag">{tag.label}</span>
        ))}
      </div>
    )}

    <section class="sessions-section">
      <h2 class="section-title">Dónde ver {movie.title}</h2>
      <p class="section-meta">
        Hoy · Madrid · hasta 20 km
        {totalSessions > 0 && <span class="session-count"> · {totalSessions} sesiones</span>}
      </p>

      {cinemaResults.length > 0 ? (
        <div class="sessions-list">
          {cinemaResults.map(cr => (
            <CinemaResult
              cinemaName={cr.cinema.name}
              distance={cr.distance !== undefined ? `${cr.distance.toFixed(1)} km` : ''}
              showtimes={cr.showtimes.map(st => ({
                time: st.time,
                language: st.language,
                price: st.price !== undefined ? `${st.price.toFixed(2).replace('.', ',')} €` : undefined,
                format: st.format !== '2D' ? st.format : undefined,
                url: st.bookingUrl || cr.cinema.bookingBaseUrl,
              }))}
              website={cr.cinema.bookingBaseUrl}
            />
          ))}
        </div>
      ) : (
        <p class="no-sessions">No hay sesiones disponibles hoy. <a href={`/buscar?pelicula=${movie.slug}&city=madrid&radius=20`}>Ver otros días</a></p>
      )}

      <a href={`/buscar?pelicula=${movie.slug}&city=madrid&radius=10`} class="see-all-link">
        Ver todas las sesiones →
      </a>
    </section>

    {movie.editorialReview && (
      <MovieReview
        score={movie.editorialReview.score}
        reviewText={movie.editorialReview.text}
        categories={categories}
      />
    )}

    {movie.worthIt && (
      <MovieWorthIt
        reasonsYes={movie.worthIt.yes}
        reasonsNo={movie.worthIt.no}
      />
    )}

    {similarMovies.length > 0 && (
      <section class="similar-section">
        <h2 class="section-title">Si te gusta esta...</h2>
        <div class="similar-scroll">
          {similarMovies.map(m => (
            <PosterCard
              title={m.title}
              slug={m.slug}
              rating={m.rating}
              genre={m.genres[0]}
              posterColor={m.posterColor}
            />
          ))}
        </div>
      </section>
    )}
  </article>
</Layout>

<style>
  .movie-page {
    max-width: var(--container-narrow);
    margin: 0 auto;
    padding: 0 var(--space-4) var(--space-16);
  }

  .breadcrumb {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    padding: var(--space-4) 0 0;
  }

  .breadcrumb a {
    color: var(--color-text-tertiary);
    text-decoration: none;
  }

  .breadcrumb a:hover {
    color: var(--color-text);
  }

  .editorial-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-8);
  }

  .editorial-tag {
    font-size: var(--text-sm);
    padding: var(--space-1) var(--space-3);
    background-color: var(--color-accent-subtle);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
  }

  .sessions-section {
    padding: var(--space-6) 0;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: var(--space-6);
  }

  .section-title {
    font-size: var(--text-lg);
    font-weight: 600;
    margin-bottom: var(--space-2);
  }

  .section-meta {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-4);
  }

  .session-count {
    color: var(--color-text-tertiary);
  }

  .no-sessions {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    padding: var(--space-6) 0;
  }

  .no-sessions a {
    color: var(--color-text);
    text-decoration: underline;
  }

  .see-all-link {
    display: inline-block;
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text-secondary);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .see-all-link:hover {
    color: var(--color-text);
  }

  .similar-section {
    padding: var(--space-6) 0;
  }

  .similar-scroll {
    display: flex;
    gap: var(--space-3);
    margin-top: var(--space-4);
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: var(--space-2);
  }

  .similar-scroll::-webkit-scrollbar {
    display: none;
  }
</style>
