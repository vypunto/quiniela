---
import Layout from '../components/Layout.astro';
import SearchFilters from '../components/SearchFilters.astro';
import { getAllMovies, getAllCinemas, getShowtimes } from '../lib/search/searchEngine';

const allMovies = getAllMovies();
const allCinemas = getAllCinemas();
const allShowtimes = getShowtimes();

const moviesForSearch = allMovies.map(m => ({ title: m.title, slug: m.slug, year: m.year, id: m.id }));

const serializedMovies = allMovies.map(m => ({
  id: m.id,
  title: m.title,
  slug: m.slug,
  genres: m.genres,
  moods: m.moods || [],
}));

const serializedCinemas = allCinemas.map(c => ({
  id: c.id,
  name: c.name,
  slug: c.slug,
  city: c.city,
  lat: c.latitude,
  lng: c.longitude,
  bookingBaseUrl: c.bookingBaseUrl,
}));

const serializedShowtimes = allShowtimes.map(st => ({
  id: st.id,
  movieId: st.movieId,
  cinemaId: st.cinemaId,
  date: st.date,
  time: st.time,
  language: st.language,
  format: st.format,
  price: st.price,
  bookingUrl: st.bookingUrl,
}));
---

<Layout title="Buscar sesiones" description="Busca sesiones de cine en Madrid. Filtra por película, día, hora, idioma y formato.">
  <div class="results-page container--narrow">
    <header class="results-header" id="results-header">
      <a href="/" class="results-back">← Volver</a>
      <span class="mark" aria-hidden="true"></span>
      <h1 class="results-title" id="results-title">Buscando...</h1>
      <div class="results-meta" id="results-meta"></div>
      <p class="results-count" id="results-count"></p>
    </header>

    <div class="intent-summary" id="intent-summary" style="display:none;">
      <div class="intent-chips" id="intent-chips"></div>
      <a href="/" class="btn-text">Editar búsqueda</a>
    </div>

    <SearchFilters />

    <div id="results-container">
      <div class="loading-state" id="loading-state">
        <p>Cargando sesiones...</p>
      </div>
    </div>
  </div>

  <script define:vars={{ serializedMovies, serializedCinemas, serializedShowtimes, moviesForSearch }}>
    window.__MOVIES__ = moviesForSearch;
    window.__ALL_MOVIES__ = serializedMovies;
    window.__ALL_CINEMAS__ = serializedCinemas;
    window.__ALL_SHOWTIMES__ = serializedShowtimes;
  </script>

  <script>
    interface MovieData { id: string; title: string; slug: string; genres: string[]; moods: string[]; }
    interface CinemaData { id: string; name: string; slug: string; city: string; lat: number; lng: number; bookingBaseUrl: string; }
    interface ShowtimeData { id: string; movieId: string; cinemaId: string; date: string; time: string; language: string; format: string; price?: number; bookingUrl?: string; }

    function haversine(lat1: number, lng1: number, lat2: number, lng2: number): number {
      const R = 6371;
      const dLat = (lat2 - lat1) * Math.PI / 180;
      const dLng = (lng2 - lng1) * Math.PI / 180;
      const a = Math.sin(dLat/2)**2 + Math.cos(lat1*Math.PI/180) * Math.cos(lat2*Math.PI/180) * Math.sin(dLng/2)**2;
      return R * 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    }

    const DAY_NAMES = ['Domingo','Lunes','Martes','Miércoles','Jueves','Viernes','Sábado'];
    const MONTH_NAMES = ['enero','febrero','marzo','abril','mayo','junio','julio','agosto','septiembre','octubre','noviembre','diciembre'];

    function formatDateDisplay(dateStr: string): string {
      if (!dateStr) return '';
      const d = new Date(dateStr + 'T12:00:00');
      return `${DAY_NAMES[d.getDay()]} ${d.getDate()} ${MONTH_NAMES[d.getMonth()]}`;
    }

    const DAY_INDEX: Record<string, number> = {
      domingo: 0, lunes: 1, martes: 2, miercoles: 3, jueves: 4, viernes: 5, sabado: 6,
    };

    function resolveDay(q: string): string | undefined {
      const now = new Date();
      if (q.includes('hoy')) return formatDateISO(now);
      if (q.includes('manana') && !q.includes('por la manana')) {
        const d = new Date(now); d.setDate(d.getDate() + 1); return formatDateISO(d);
      }
      for (const [name, target] of Object.entries(DAY_INDEX)) {
        if (q.includes(name)) {
          const d = new Date(now);
          let ahead = target - d.getDay();
          if (ahead <= 0) ahead += 7;
          d.setDate(d.getDate() + ahead);
          return formatDateISO(d);
        }
      }
      return undefined;
    }

    function formatDateISO(d: Date): string {
      return `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
    }

    // Client-side intent parser
    function parseQueryIntent(query: string): { genres: string[]; moods: string[]; timeFrom?: string; timeTo?: string; movie?: string; date?: string } {
      const q = query.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
      const genres: string[] = [];
      const moods: string[] = [];
      let timeFrom: string | undefined;
      let timeTo: string | undefined;
      let movie: string | undefined;
      const date = resolveDay(q);

      const genreMap: Record<string, string> = {
        terror: 'Terror', horror: 'Terror', miedo: 'Terror',
        comedia: 'Comedia', divertida: 'Comedia', divertido: 'Comedia', reir: 'Comedia',
        drama: 'Drama',
        accion: 'Aventura', aventura: 'Aventura', aventuras: 'Aventura',
        'ciencia ficcion': 'Ciencia ficcion', scifi: 'Ciencia ficcion',
        animacion: 'Animacion', animada: 'Animacion',
        musical: 'Musical',
        romance: 'Romance', romantica: 'Romance', romantico: 'Romance',
        thriller: 'Drama',
        fantasia: 'Fantasia',
        historico: 'Historico', historica: 'Historico',
      };

      const moodMap: Record<string, string> = {
        divertida: 'divertida', divertido: 'divertida',
        intensa: 'intensa', intenso: 'intensa',
        romantica: 'romantica', romantico: 'romantica',
        pensar: 'reflexiva', reflexionar: 'reflexiva', reflexiva: 'reflexiva',
        espectacular: 'espectacular',
        rara: 'rara', raro: 'rara',
        llorar: 'emotiva', emotiva: 'emotiva',
        familiar: 'familiar',
        contemplativa: 'contemplativa',
      };

      for (const [key, val] of Object.entries(genreMap)) {
        if (q.includes(key) && !genres.includes(val)) genres.push(val);
      }
      for (const [key, val] of Object.entries(moodMap)) {
        if (q.includes(key) && !moods.includes(val)) moods.push(val);
      }

      // Time parsing
      const timeMatch = q.match(/sobre las (\d{1,2})/);
      if (timeMatch) {
        let h = parseInt(timeMatch[1]);
        if (h < 12) h += 12;
        timeFrom = `${String(h - 1).padStart(2, '0')}:00`;
        timeTo = `${String(h + 1).padStart(2, '0')}:30`;
      }
      if (q.includes('despues de cenar') || q.includes('noche')) {
        timeFrom = '21:00';
      }
      if (q.includes('tarde')) {
        timeFrom = '16:00';
        timeTo = '20:00';
      }

      // "parecido a" / "como"
      const similarMatch = q.match(/(?:parecido a|como) (.+?)(?:\s*$)/);
      if (similarMatch) {
        const movies = (window as any).__ALL_MOVIES__ as MovieData[];
        const target = similarMatch[1].trim();
        const found = movies.find(m =>
          m.title.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').includes(target)
        );
        if (found) {
          movie = found.slug;
          for (const g of found.genres) {
            if (!genres.includes(g)) genres.push(g);
          }
          for (const mo of found.moods) {
            if (!moods.includes(mo)) moods.push(mo);
          }
        }
      }

      // "primera cita" → romántica + divertida
      if (q.includes('primera cita') || q.includes('cita')) {
        if (!moods.includes('romantica')) moods.push('romantica');
        if (!moods.includes('divertida')) moods.push('divertida');
      }

      // "padre" / "familia" → familiar
      if (q.includes('padre') || q.includes('madre') || q.includes('familia') || q.includes('hijo')) {
        if (!moods.includes('familiar')) moods.push('familiar');
      }

      return { genres, moods, timeFrom, timeTo, movie, date };
    }

    interface CinemaGroup {
      cinema: CinemaData;
      distance: number;
      showtimes: ShowtimeData[];
      movieTitle?: string;
    }

    let currentResults: CinemaGroup[] = [];
    let isNaturalQuery = false;

    function performSearch() {
      const params = new URLSearchParams(window.location.search);
      const movieSlug = params.get('pelicula') || '';
      const naturalQuery = params.get('q') || '';
      let dateParam = params.get('date') || '';
      const timeFrom = params.get('from') || '';
      const timeTo = params.get('to') || '';
      const city = params.get('city') || 'madrid';
      const radius = parseFloat(params.get('radius') || '10');
      const userLat = parseFloat(params.get('lat') || '40.4168');
      const userLng = parseFloat(params.get('lng') || '-3.7038');

      const movies = (window as any).__ALL_MOVIES__ as MovieData[];
      const cinemas = (window as any).__ALL_CINEMAS__ as CinemaData[];
      const showtimes = (window as any).__ALL_SHOWTIMES__ as ShowtimeData[];

      let movieTitle = 'Todas las películas';
      let matchedMovieIds: Set<string> | null = null;
      let intentTimeFrom = timeFrom;
      let intentTimeTo = timeTo;
      isNaturalQuery = false;

      const intentSummary = document.getElementById('intent-summary')!;
      const intentChips = document.getElementById('intent-chips')!;

      if (movieSlug) {
        // Direct movie search
        const movie = movies.find(m => m.slug === movieSlug);
        if (movie) {
          movieTitle = movie.title;
          matchedMovieIds = new Set([movie.id]);
        }
        intentSummary.style.display = 'none';
      } else if (naturalQuery) {
        // Natural language query
        isNaturalQuery = true;
        const intent = parseQueryIntent(naturalQuery);

        // Find matching movies by genre/mood
        let candidates = movies;

        if (intent.movie) {
          // "parecido a X" — exclude the source movie
          const source = movies.find(m => m.slug === intent.movie);
          if (source) {
            candidates = movies.filter(m => m.id !== source.id);
          }
        }

        if (intent.genres.length > 0 || intent.moods.length > 0) {
          candidates = candidates.filter(m => {
            const genreMatch = intent.genres.length === 0 || m.genres.some(g =>
              intent.genres.some(ig => g.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').includes(ig.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')))
            );
            const moodMatch = intent.moods.length === 0 || m.moods.some(mo =>
              intent.moods.includes(mo)
            );
            // Both criteria must hold — an empty list is a pass, not a wildcard "or".
            return genreMatch && moodMatch;
          });
          // Sort by relevance (more matching criteria = higher)
          candidates.sort((a, b) => {
            const aScore = (intent.genres.filter(g => a.genres.some(ag => ag.toLowerCase().includes(g.toLowerCase()))).length) +
                           (intent.moods.filter(mo => a.moods.includes(mo)).length);
            const bScore = (intent.genres.filter(g => b.genres.some(bg => bg.toLowerCase().includes(g.toLowerCase()))).length) +
                           (intent.moods.filter(mo => b.moods.includes(mo)).length);
            return bScore - aScore;
          });
        }

        matchedMovieIds = new Set(candidates.map(m => m.id));
        movieTitle = naturalQuery;

        if (intent.timeFrom) intentTimeFrom = intent.timeFrom;
        if (intent.timeTo) intentTimeTo = intent.timeTo;
        if (intent.date && !dateParam) dateParam = intent.date;

        // Show intent summary
        const chips: string[] = [];
        if (intent.genres.length) chips.push(...intent.genres);
        if (intent.moods.length) chips.push(...intent.moods.map(m => m.charAt(0).toUpperCase() + m.slice(1)));
        if (intent.date) chips.push(formatDateDisplay(intent.date));
        if (intentTimeFrom) chips.push(`~${intentTimeFrom}`);
        chips.push(city.charAt(0).toUpperCase() + city.slice(1));

        if (chips.length > 0) {
          intentChips.innerHTML = chips.map(c => `<span class="intent-chip">${c}</span>`).join('');
          intentSummary.style.display = '';
        } else {
          intentSummary.style.display = 'none';
        }
      } else {
        intentSummary.style.display = 'none';
      }

      // Filter showtimes
      let filtered = showtimes;

      if (matchedMovieIds) {
        filtered = filtered.filter(st => matchedMovieIds!.has(st.movieId));
      }
      if (dateParam) {
        filtered = filtered.filter(st => st.date === dateParam);
      }
      if (intentTimeFrom) {
        filtered = filtered.filter(st => st.time >= intentTimeFrom);
      }
      if (intentTimeTo) {
        filtered = filtered.filter(st => st.time <= intentTimeTo);
      }

      // Group by cinema and calculate distance
      const cinemaMap = new Map<string, ShowtimeData[]>();
      for (const st of filtered) {
        const arr = cinemaMap.get(st.cinemaId) || [];
        arr.push(st);
        cinemaMap.set(st.cinemaId, arr);
      }

      const groups: CinemaGroup[] = [];
      for (const [cinemaId, sts] of cinemaMap) {
        const cinema = cinemas.find(c => c.id === cinemaId);
        if (!cinema) continue;
        const dist = haversine(userLat, userLng, cinema.lat, cinema.lng);
        if (dist > radius) continue;
        sts.sort((a, b) => a.time.localeCompare(b.time));

        // For natural queries, add movie title to each group
        if (isNaturalQuery) {
          // Sub-group by movie within cinema
          const movieMap = new Map<string, ShowtimeData[]>();
          for (const st of sts) {
            const arr = movieMap.get(st.movieId) || [];
            arr.push(st);
            movieMap.set(st.movieId, arr);
          }
          for (const [movieId, movieSts] of movieMap) {
            const movie = movies.find(m => m.id === movieId);
            groups.push({ cinema, distance: dist, showtimes: movieSts, movieTitle: movie?.title });
          }
        } else {
          groups.push({ cinema, distance: dist, showtimes: sts });
        }
      }

      groups.sort((a, b) => b.showtimes.length - a.showtimes.length || a.distance - b.distance);
      currentResults = groups;

      // Update header
      const titleEl = document.getElementById('results-title')!;
      const metaEl = document.getElementById('results-meta')!;
      titleEl.textContent = movieTitle;

      const metaParts: string[] = [];
      if (dateParam) metaParts.push(formatDateDisplay(dateParam));
      metaParts.push(city.charAt(0).toUpperCase() + city.slice(1));
      metaParts.push(`hasta ${radius} km`);
      metaEl.innerHTML = metaParts.map(p => `<span>${p}</span>`).join('');

      renderResults();
    }

    function renderResults() {
      const container = document.getElementById('results-container')!;
      const countEl = document.getElementById('results-count')!;

      // Get filter state
      const langChip = document.querySelector('.filter-chips[data-filter="language"] .filter-chip.active') as HTMLElement;
      const fmtChip = document.querySelector('.filter-chips[data-filter="format"] .filter-chip.active') as HTMLElement;
      const sortChip = document.querySelector('.filter-chips[data-filter="sort"] .filter-chip.active') as HTMLElement;

      const lang = langChip?.dataset.value || 'all';
      const fmt = fmtChip?.dataset.value || 'all';
      const sort = sortChip?.dataset.value || 'relevancia';

      let groups = currentResults.map(g => {
        let sts = g.showtimes;
        if (lang !== 'all') {
          const langMap: Record<string, string> = { castellano: 'castellano', vo: 'VO', vose: 'VOSE' };
          sts = sts.filter(s => s.language === langMap[lang]);
        }
        if (fmt !== 'all') {
          sts = sts.filter(s => {
            if (fmt === '2d') return s.format === '2D';
            if (fmt === '3d') return s.format === '3D' || s.format === 'IMAX 3D';
            if (fmt === 'imax') return s.format === 'IMAX' || s.format === 'IMAX 3D';
            return true;
          });
        }
        return { ...g, showtimes: sts };
      }).filter(g => g.showtimes.length > 0);

      if (sort === 'cercania') groups.sort((a, b) => a.distance - b.distance);
      else if (sort === 'hora') groups.sort((a, b) => (a.showtimes[0]?.time || '').localeCompare(b.showtimes[0]?.time || ''));
      else if (sort === 'precio') groups.sort((a, b) => Math.min(...a.showtimes.map(s => s.price ?? 999)) - Math.min(...b.showtimes.map(s => s.price ?? 999)));

      let total = 0;
      groups.forEach(g => total += g.showtimes.length);
      countEl.textContent = total > 0 ? `${total} sesiones encontradas` : '';

      if (groups.length === 0) {
        const params = new URLSearchParams(window.location.search);
        const slug = params.get('pelicula') || '';
        const q = params.get('q') || '';
        const city = params.get('city') || 'madrid';
        const backParam = slug ? `pelicula=${slug}` : (q ? `q=${encodeURIComponent(q)}` : '');
        container.innerHTML = `
          <div class="empty-state">
            <p class="empty-title">No encontramos sesiones que encajen.</p>
            <p class="empty-sub">Prueba ampliando el radio o cambiando la hora.</p>
            <div class="empty-actions">
              <a href="/buscar?${backParam}&city=${city}&radius=20" class="empty-btn">Ampliar radio</a>
              <a href="/buscar?${backParam}&city=${city}&radius=20" class="empty-btn">Ver todas las horas</a>
              <a href="/" class="empty-btn empty-btn-secondary">Nueva búsqueda</a>
            </div>
          </div>`;
        return;
      }

      container.innerHTML = `<div class="results-list">${groups.map(g => `
        <div class="cinema-result-card">
          <div class="cr-header">
            <div>
              <a href="/cine/${g.cinema.slug}" class="cr-name">${g.cinema.name}</a>
              ${g.movieTitle ? `<span class="cr-movie-title">${g.movieTitle}</span>` : ''}
            </div>
            <a href="${g.showtimes[0]?.bookingUrl || g.cinema.bookingBaseUrl}" target="_blank" rel="noopener noreferrer" class="btn-buy">
              Comprar
              <svg class="arrow" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              <span class="wipe"></span>
            </a>
          </div>
          <span class="cr-distance">${g.distance.toFixed(1)} km</span>
          <div class="cr-showtimes">
            ${g.showtimes.map(st => `
              <span class="cr-time-block">
                <span class="cr-time">${st.time}</span>
                <span class="cr-tag">${st.language}</span>
                ${st.format !== '2D' ? `<span class="cr-tag">${st.format}</span>` : ''}
                ${st.price !== undefined ? `<span class="cr-price">${st.price.toFixed(2).replace('.', ',')} €</span>` : ''}
              </span>
            `).join('')}
          </div>
        </div>
      `).join('')}</div>`;
    }

    document.addEventListener('DOMContentLoaded', () => {
      performSearch();
    });

    document.addEventListener('filterchange', () => {
      renderResults();
    });
  </script>
</Layout>

<style>
  .results-page {
    max-width: var(--container-narrow);
    margin: 0 auto;
    padding: var(--space-4) var(--space-4) var(--space-16);
  }

  .container--narrow {
    max-width: var(--container-narrow);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  .results-back {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    text-decoration: none;
    margin-bottom: var(--space-3);
    transition: color var(--transition-fast);
  }

  .results-back:hover {
    color: var(--color-text);
  }

  .results-header {
    margin-bottom: var(--space-4);
    padding-bottom: var(--space-4);
    border-bottom: 1px solid var(--color-border);
  }

  .results-title {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    font-size: 2.2rem;
    letter-spacing: -0.02em;
    margin-bottom: var(--space-2);
  }

  .results-meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
  }

  .results-meta :global(span:not(:last-child))::after {
    content: ' · ';
  }

  .results-count {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    margin-top: var(--space-2);
    font-variant-numeric: tabular-nums;
  }

  /* Intent summary */
  .intent-summary {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
    padding: var(--space-3) var(--space-4);
    background: var(--color-surface);
    border-radius: var(--radius-md);
  }

  :global(.intent-chip) {
    font-size: var(--text-xs);
    font-weight: 500;
    padding: var(--space-1) var(--space-2);
    background: var(--color-accent-subtle);
    border-radius: var(--radius-sm);
    color: var(--color-text-secondary);
  }

  :global(.intent-chips) {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    flex: 1;
  }

  .intent-edit {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    white-space: nowrap;
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  .intent-edit:hover {
    color: var(--color-text);
  }

  .loading-state {
    text-align: center;
    padding: var(--space-12) 0;
    color: var(--color-text-tertiary);
  }

  .results-list {
    animation: fadeIn var(--transition-slow) ease;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  :global(.cinema-result-card) {
    padding: var(--space-6) 0;
    border-top: 1px solid var(--color-border-alt);
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 4px var(--space-4);
  }

  :global(.cinema-result-card:last-child) {
    border-bottom: 1px solid var(--color-border-alt);
  }

  :global(.cr-header) {
    grid-column: 1 / -1;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }

  :global(.cr-name) {
    font-size: 1.14rem;
    font-weight: 700;
    color: var(--color-text);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  :global(.cr-name:hover) {
    color: var(--color-text-secondary);
  }

  :global(.cr-movie-title) {
    display: block;
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-top: 2px;
  }

  :global(.cr-distance) {
    font-size: .84rem;
    font-weight: 500;
    color: var(--color-text-tertiary);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
