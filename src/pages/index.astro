---
import Layout from '../components/Layout.astro';
import PosterCard from '../components/PosterCard.astro';
import PosterRail from '../components/PosterRail.astro';
import { getAllMovies, getShowtimes } from '../lib/search/searchEngine';

const movies = getAllMovies();
const moviesForSearch = movies.map(m => ({ title: m.title, slug: m.slug, year: m.year }));

const today = new Date();
const todayStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;

// Ahora en cartelera: movies that have showtimes today
const allShowtimes = getShowtimes({ date: todayStr });
const movieIdsWithShowings = new Set(allShowtimes.map(st => st.movieId));
const nowShowing = movies.filter(m => movieIdsWithShowings.has(m.id));

// Estrenos: movies with releaseDate in last 30 days or future
const thirtyDaysAgo = new Date(today);
thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
const thirtyDaysAgoStr = `${thirtyDaysAgo.getFullYear()}-${String(thirtyDaysAgo.getMonth() + 1).padStart(2, '0')}-${String(thirtyDaysAgo.getDate()).padStart(2, '0')}`;
const newReleases = movies
  .filter(m => m.releaseDate && m.releaseDate >= thirtyDaysAgoStr)
  .sort((a, b) => (b.releaseDate || '').localeCompare(a.releaseDate || ''));

// Le quedan pocos días: movies with few remaining showtime dates
const allFutureShowtimes = getShowtimes();
const movieLastDate = new Map<string, string>();
for (const st of allFutureShowtimes) {
  const current = movieLastDate.get(st.movieId);
  if (!current || st.date > current) {
    movieLastDate.set(st.movieId, st.date);
  }
}
const sevenDaysOut = new Date(today);
sevenDaysOut.setDate(sevenDaysOut.getDate() + 4);
const sevenDaysOutStr = `${sevenDaysOut.getFullYear()}-${String(sevenDaysOut.getMonth() + 1).padStart(2, '0')}-${String(sevenDaysOut.getDate()).padStart(2, '0')}`;
const lastDays = movies
  .filter(m => {
    const lastDate = movieLastDate.get(m.id);
    return lastDate && lastDate <= sevenDaysOutStr && lastDate >= todayStr;
  })
  .slice(0, 6);
---

<Layout title="SmallParadiso" description="Encuentra sesiones de cine cerca de ti. Busca por película, día, hora y ubicación.">
  <div class="home">
    <!-- HERO + BUSCADOR -->
    <section class="hero">
      <div class="hero-inner container--narrow">
        <p class="hero-eyebrow">SMALLPARADISO</p>
        <h1 class="hero-title">¿Qué te apetece ver?</h1>
        <p class="hero-sub">Busca una película o cuéntanos qué estás buscando.</p>

        <div class="search-wrapper" id="search-wrapper">
          <div class="search-icon" aria-hidden="true">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="11" cy="11" r="8"></circle>
              <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
            </svg>
          </div>
          <input
            type="text"
            placeholder="Busca una película o cuéntanos qué te apetece..."
            id="main-search"
            autocomplete="off"
            aria-label="Buscar película o describir lo que quieres ver"
            aria-expanded="false"
            aria-controls="search-suggestions"
            aria-autocomplete="list"
            role="combobox"
            class="main-search-input"
          />
          <button type="button" class="search-go" id="search-go-btn" aria-label="Buscar">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="5" y1="12" x2="19" y2="12"></line>
              <polyline points="12 5 19 12 12 19"></polyline>
            </svg>
          </button>
          <ul class="search-suggestions" id="search-suggestions" role="listbox" aria-label="Sugerencias"></ul>
        </div>

        <div class="examples" id="examples-row">
          <span class="examples-label">Prueba con:</span>
          <button class="example-chip" data-query="Una de terror para el sábado sobre las 9">Una de terror para el sábado sobre las 9</button>
          <button class="example-chip" data-query="Algo parecido a The Substance">Algo parecido a The Substance</button>
          <button class="example-chip" data-query="Una película para una primera cita">Una película para una primera cita</button>
        </div>

        <p class="title-search-hint">
          ¿Ya sabes cuál quieres ver? <button class="title-search-link" id="title-search-link">Buscar por título →</button>
        </p>
      </div>
    </section>

    <!-- ¿NO SABES QUÉ VER? -->
    <section class="mood-section container--narrow">
      <h2 class="mood-title">¿No sabes qué ver?</h2>
      <p class="mood-sub">Cuéntanos qué te apetece.</p>
      <div class="mood-chips">
        <button class="mood-chip" data-mood="divertida">Algo divertido</button>
        <button class="mood-chip" data-mood="intensa">Algo intenso</button>
        <button class="mood-chip" data-mood="romantica">Algo romántico</button>
        <button class="mood-chip" data-mood="reflexiva">Algo que me haga pensar</button>
        <button class="mood-chip" data-mood="espectacular">Algo espectacular</button>
        <button class="mood-chip" data-mood="rara">Algo raro</button>
      </div>
    </section>

    <!-- AHORA EN CARTELERA -->
    {nowShowing.length > 0 && (
      <PosterRail title="Ahora en cartelera" subtitle="Películas que puedes ver ahora.">
        {nowShowing.map(m => (
          <PosterCard
            title={m.title}
            slug={m.slug}
            rating={m.rating}
            genre={m.genres[0]}
            posterColor={m.posterColor}
          />
        ))}
      </PosterRail>
    )}

    <!-- ESTRENOS -->
    {newReleases.length > 0 && (
      <PosterRail title="Estrenos" subtitle="Lo nuevo que llega a los cines.">
        {newReleases.map(m => (
          <PosterCard
            title={m.title}
            slug={m.slug}
            rating={m.rating}
            genre={m.genres[0]}
            posterColor={m.posterColor}
          />
        ))}
      </PosterRail>
    )}

    <!-- LE QUEDAN POCOS DÍAS -->
    {lastDays.length > 0 && (
      <PosterRail title="Le quedan pocos días" subtitle="Si quieres verla en pantalla grande, no la dejes pasar.">
        {lastDays.map(m => (
          <PosterCard
            title={m.title}
            slug={m.slug}
            rating={m.rating}
            genre={m.genres[0]}
            posterColor={m.posterColor}
          />
        ))}
      </PosterRail>
    )}
  </div>

  <script define:vars={{ moviesForSearch }}>
    window.__MOVIES__ = moviesForSearch;
  </script>

  <script>
    const input = document.getElementById('main-search') as HTMLInputElement;
    const suggestions = document.getElementById('search-suggestions') as HTMLUListElement;
    const goBtn = document.getElementById('search-go-btn') as HTMLButtonElement;
    let activeIndex = -1;
    let debounceTimer: ReturnType<typeof setTimeout>;

    function getMovies(): Array<{ title: string; slug: string; year?: number }> {
      return (window as any).__MOVIES__ || [];
    }

    function filterMovies(query: string) {
      if (!query || query.length < 2) return [];
      const q = query.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
      return getMovies()
        .filter(m => {
          const t = m.title.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
          return t.includes(q);
        })
        .slice(0, 6);
    }

    function renderSuggestions(movies: Array<{ title: string; slug: string; year?: number }>) {
      if (movies.length === 0) {
        suggestions.innerHTML = '';
        suggestions.classList.remove('visible');
        input.setAttribute('aria-expanded', 'false');
        return;
      }

      suggestions.innerHTML = movies.map((m, i) => `
        <li role="option" id="suggestion-${i}" class="suggestion-item" data-slug="${m.slug}">
          <span class="suggestion-title">${m.title}</span>
          ${m.year ? `<span class="suggestion-year">${m.year}</span>` : ''}
        </li>
      `).join('');

      suggestions.classList.add('visible');
      input.setAttribute('aria-expanded', 'true');
      activeIndex = -1;

      suggestions.querySelectorAll('.suggestion-item').forEach(item => {
        item.addEventListener('click', () => {
          const slug = (item as HTMLElement).dataset.slug;
          window.location.href = `/buscar?pelicula=${slug}`;
        });
      });
    }

    function setActive(index: number) {
      const items = suggestions.querySelectorAll('.suggestion-item');
      items.forEach(el => el.classList.remove('active'));
      if (index >= 0 && index < items.length) {
        items[index].classList.add('active');
        items[index].scrollIntoView({ block: 'nearest' });
        input.setAttribute('aria-activedescendant', `suggestion-${index}`);
      } else {
        input.removeAttribute('aria-activedescendant');
      }
    }

    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        const q = input.value.trim();
        const results = filterMovies(q);
        renderSuggestions(results);
      }, 150);
    });

    input.addEventListener('keydown', (e) => {
      const items = suggestions.querySelectorAll('.suggestion-item');
      const count = items.length;

      if (e.key === 'ArrowDown' && count > 0) {
        e.preventDefault();
        activeIndex = (activeIndex + 1) % count;
        setActive(activeIndex);
      } else if (e.key === 'ArrowUp' && count > 0) {
        e.preventDefault();
        activeIndex = activeIndex <= 0 ? count - 1 : activeIndex - 1;
        setActive(activeIndex);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (activeIndex >= 0 && items[activeIndex]) {
          const slug = (items[activeIndex] as HTMLElement).dataset.slug;
          window.location.href = `/buscar?pelicula=${slug}`;
        } else {
          executeSearch();
        }
      } else if (e.key === 'Escape') {
        suggestions.classList.remove('visible');
        input.setAttribute('aria-expanded', 'false');
        activeIndex = -1;
      }
    });

    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('#search-wrapper')) {
        suggestions.classList.remove('visible');
        input.setAttribute('aria-expanded', 'false');
      }
    });

    function executeSearch() {
      const query = input.value.trim();
      if (!query) return;

      // Check if it matches a movie title exactly
      const movies = getMovies();
      const exact = movies.find(m =>
        m.title.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '') ===
        query.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')
      );

      if (exact) {
        window.location.href = `/buscar?pelicula=${exact.slug}`;
      } else {
        window.location.href = `/buscar?q=${encodeURIComponent(query)}`;
      }
    }

    goBtn.addEventListener('click', executeSearch);

    // Example chips
    document.querySelectorAll('.example-chip').forEach(btn => {
      btn.addEventListener('click', () => {
        const query = (btn as HTMLElement).dataset.query || '';
        input.value = query;
        input.focus();
        executeSearch();
      });
    });

    // Mood chips
    document.querySelectorAll('.mood-chip').forEach(btn => {
      btn.addEventListener('click', () => {
        const mood = (btn as HTMLElement).dataset.mood || '';
        window.location.href = `/buscar?q=${encodeURIComponent('Algo ' + mood)}`;
      });
    });

    // "Buscar por título" link
    const titleLink = document.getElementById('title-search-link');
    titleLink?.addEventListener('click', () => {
      input.focus();
      input.placeholder = 'Escribe el nombre de la película...';
    });

    // Rotate examples
    const exampleChips = document.querySelectorAll('.example-chip');
    const allExamples = [
      'Una de terror para el sábado sobre las 9',
      'Algo parecido a The Substance',
      'Una película para una primera cita',
      'Algo divertido para esta noche',
      'Una película que me haga pensar',
      'Terror en VOSE cerca de Chueca',
      'Algo de aventuras para ver con mi padre',
      'Algo que me haga llorar',
    ];
    let exampleSet = 0;

    setInterval(() => {
      exampleSet = (exampleSet + 1) % Math.ceil(allExamples.length / 3);
      const start = (exampleSet * 3) % allExamples.length;
      exampleChips.forEach((chip, i) => {
        const idx = (start + i) % allExamples.length;
        const el = chip as HTMLElement;
        el.style.opacity = '0';
        setTimeout(() => {
          el.textContent = allExamples[idx];
          el.dataset.query = allExamples[idx];
          el.style.opacity = '1';
        }, 200);
      });
    }, 6000);
  </script>
</Layout>

<style>
  .home {
    padding-bottom: var(--space-8);
  }

  .container--narrow {
    max-width: var(--container-narrow);
    margin: 0 auto;
    padding: 0 var(--space-4);
  }

  /* HERO */
  .hero {
    padding: var(--space-16) 0 var(--space-12);
    text-align: center;
  }

  .hero-eyebrow {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.16em;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-4);
  }

  .hero-title {
    font-size: var(--text-5xl);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
    margin-bottom: var(--space-3);
    text-wrap: balance;
  }

  .hero-sub {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-8);
  }

  /* SEARCH */
  .search-wrapper {
    position: relative;
    max-width: 560px;
    margin: 0 auto var(--space-5);
  }

  .search-icon {
    position: absolute;
    left: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
    color: var(--color-text-tertiary);
    pointer-events: none;
    line-height: 0;
  }

  .main-search-input {
    width: 100%;
    padding: var(--space-4) var(--space-12) var(--space-4) 48px;
    font-size: var(--text-base);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background-color: var(--color-surface);
    color: var(--color-text);
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .main-search-input::placeholder {
    color: var(--color-text-tertiary);
    font-size: var(--text-sm);
  }

  .main-search-input:focus {
    border-color: var(--color-accent);
    box-shadow: 0 0 0 3px rgba(17, 17, 17, 0.06);
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .main-search-input:focus {
      box-shadow: 0 0 0 3px rgba(245, 245, 245, 0.08);
    }
  }

  .search-go {
    position: absolute;
    right: 6px;
    top: 50%;
    transform: translateY(-50%);
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    color: var(--color-bg);
    background: var(--color-accent);
    transition: background var(--transition-fast);
    cursor: pointer;
  }

  .search-go:hover {
    background: var(--color-accent-hover);
  }

  .search-suggestions {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    right: 0;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    max-height: 320px;
    overflow-y: auto;
    z-index: 50;
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .search-suggestions.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  :global(.suggestion-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  :global(.suggestion-item:hover),
  :global(.suggestion-item.active) {
    background-color: var(--color-accent-subtle);
  }

  :global(.suggestion-title) {
    font-size: var(--text-base);
    font-weight: 500;
  }

  :global(.suggestion-year) {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  /* EXAMPLES */
  .examples {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    margin-bottom: var(--space-6);
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }

  .examples-label {
    font-size: var(--text-xs);
    color: var(--color-text-tertiary);
    white-space: nowrap;
  }

  .example-chip {
    font-size: var(--text-xs);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
    background: none;
    font-family: inherit;
    white-space: nowrap;
  }

  .example-chip:hover {
    border-color: var(--color-text-tertiary);
    color: var(--color-text);
  }

  .title-search-hint {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    margin-bottom: 0;
  }

  .title-search-link {
    color: var(--color-text-secondary);
    font-weight: 500;
    cursor: pointer;
    transition: color var(--transition-fast);
    background: none;
    border: none;
    font-family: inherit;
    font-size: inherit;
  }

  .title-search-link:hover {
    color: var(--color-text);
  }

  /* MOOD SECTION */
  .mood-section {
    text-align: center;
    padding: var(--space-10) 0;
    margin-bottom: var(--space-10);
    border-top: 1px solid var(--color-border);
    border-bottom: 1px solid var(--color-border);
  }

  .mood-title {
    font-size: var(--text-xl);
    font-weight: 600;
    margin-bottom: var(--space-1);
  }

  .mood-sub {
    font-size: var(--text-sm);
    color: var(--color-text-secondary);
    margin-bottom: var(--space-5);
  }

  .mood-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-2);
  }

  .mood-chip {
    padding: var(--space-2) var(--space-4);
    font-size: var(--text-sm);
    font-weight: 500;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-full);
    color: var(--color-text-secondary);
    cursor: pointer;
    transition: all var(--transition-fast);
    background: none;
    font-family: inherit;
  }

  .mood-chip:hover {
    background: var(--color-accent);
    color: var(--color-bg);
    border-color: var(--color-accent);
  }

  @media (max-width: 640px) {
    .hero {
      padding: var(--space-10) 0 var(--space-8);
    }

    .hero-eyebrow {
      margin-bottom: var(--space-3);
    }

    .hero-title {
      font-size: var(--text-3xl);
    }

    .hero-sub {
      font-size: var(--text-base);
      margin-bottom: var(--space-6);
    }

    .main-search-input {
      font-size: var(--text-sm);
    }

    .main-search-input::placeholder {
      font-size: var(--text-xs);
    }

    .examples {
      gap: var(--space-1);
    }

    .example-chip {
      font-size: 0.7rem;
    }

    .mood-section {
      padding: var(--space-8) 0;
    }
  }
</style>
