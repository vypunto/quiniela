import Layout from '../components/Layout.astro';
import PosterCard from '../components/PosterCard.astro';
import Poster from '../components/Poster.astro';
import SceneMarker from '../components/SceneMarker.astro';
import { getAllMovies, getShowtimes, getAllCinemas } from '../lib/search/searchEngine';
import { haversineDistance } from '../lib/search/distance';

const movies = getAllMovies();
const moviesForSearch = movies.map(m => ({ title: m.title, slug: m.slug, year: m.year }));

const today = new Date();
const todayStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;

// Ahora en cartelera: movies that have showtimes today
const allShowtimesToday = getShowtimes({ date: todayStr });
const movieIdsWithShowings = new Set(allShowtimesToday.map(st => st.movieId));
const nowShowing = movies.filter(m => movieIdsWithShowings.has(m.id));

// Estrenos: movies with releaseDate in last 30 days
const thirtyDaysAgo = new Date(today);
thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
const thirtyDaysAgoStr = `${thirtyDaysAgo.getFullYear()}-${String(thirtyDaysAgo.getMonth() + 1).padStart(2, '0')}-${String(thirtyDaysAgo.getDate()).padStart(2, '0')}`;
const newReleases = movies
  .filter(m => m.releaseDate && m.releaseDate >= thirtyDaysAgoStr)
  .sort((a, b) => (b.releaseDate || '').localeCompare(a.releaseDate || ''));

// Le quedan pocos días: movies with few remaining showtime dates
const allFutureShowtimes = getShowtimes();
const movieLastDate = new Map<string, string>();
for (const st of allFutureShowtimes) {
  const current = movieLastDate.get(st.movieId);
  if (!current || st.date > current) {
    movieLastDate.set(st.movieId, st.date);
  }
}
const sevenDaysOut = new Date(today);
sevenDaysOut.setDate(sevenDaysOut.getDate() + 7);
const sevenDaysOutStr = `${sevenDaysOut.getFullYear()}-${String(sevenDaysOut.getMonth() + 1).padStart(2, '0')}-${String(sevenDaysOut.getDate()).padStart(2, '0')}`;
const DAY_MS = 24 * 60 * 60 * 1000;
const lastDays = movies
  .filter(m => {
    const lastDate = movieLastDate.get(m.id);
    return lastDate && lastDate <= sevenDaysOutStr && lastDate >= todayStr;
  })
  .map(m => {
    const lastDate = movieLastDate.get(m.id)!;
    const daysLeft = Math.max(1, Math.round((new Date(lastDate + 'T12:00:00').getTime() - today.getTime()) / DAY_MS));
    return { movie: m, daysLeft };
  })
  .sort((a, b) => a.daysLeft - b.daysLeft)
  .slice(0, 8);

// Hero pick: highest-rated movie currently showing
const heroMovie = [...(nowShowing.length ? nowShowing : movies)].sort((a, b) => b.rating - a.rating)[0];

// Featured rail: a lead movie (different from hero) + the rest of nowShowing as a strip
const featuredPool = nowShowing.length ? nowShowing : movies;
const leadMovie = featuredPool.find(m => m.id !== heroMovie.id) || featuredPool[0];
const stripMovies = featuredPool.filter(m => m.id !== leadMovie.id).slice(0, 8);

// Spotlight: best-reviewed movie, distinct from the hero pick and the featured lead
const reviewed = movies.filter(m => m.editorialReview && m.id !== heroMovie.id && m.id !== leadMovie.id);
const spotlightMovie = [...reviewed].sort((a, b) => (b.editorialReview!.score) - (a.editorialReview!.score))[0] || heroMovie;
const spotlightExcerpt = spotlightMovie.editorialReview
  ? spotlightMovie.editorialReview.text.length > 220
    ? spotlightMovie.editorialReview.text.slice(0, 217).trimEnd() + '…'
    : spotlightMovie.editorialReview.text
  : spotlightMovie.synopsis.slice(0, 217).trimEnd() + '…';

// --- Escena 06: Esta semana en el cine — piezas editoriales derivadas de datos reales ---
const cinemas = getAllCinemas();
const cinemaById = new Map(cinemas.map(c => [c.id, c]));
const alreadyFeatured = new Set([heroMovie.id, leadMovie.id, spotlightMovie.id]);

// Pieza A: una sesión en formato especial hoy (dato real de showtimes), evitando repetir protagonistas ya usados
const specialFormatShowtime = allShowtimesToday.find(st => st.format !== '2D' && !alreadyFeatured.has(st.movieId))
  || allShowtimesToday.find(st => st.format !== '2D');
const specialFormatMovie = specialFormatShowtime ? movies.find(m => m.id === specialFormatShowtime.movieId) : undefined;
const specialFormatCinema = specialFormatShowtime ? cinemaById.get(specialFormatShowtime.cinemaId) : undefined;
if (specialFormatMovie) alreadyFeatured.add(specialFormatMovie.id);

// Pieza B: la etiqueta editorial que ya tenemos para el estreno más reciente, evitando repetir
const taggedMovie = newReleases.find(m => m.editorialTags.length > 0 && !alreadyFeatured.has(m.id))
  || newReleases.find(m => m.editorialTags.length > 0)
  || featuredPool.find(m => m.editorialTags.length > 0);

// Pieza C: similar por género al spotlight (misma lógica que la ficha de película)
const similarToSpotlight = movies
  .filter(m => m.id !== spotlightMovie.id)
  .map(m => ({ movie: m, score: m.genres.filter(g => spotlightMovie.genres.includes(g)).length }))
  .filter(m => m.score > 0)
  .sort((a, b) => b.score - a.score)[0]?.movie;

// --- Escena 08: Cerca de ti — cines reales más próximos al centro de Madrid ---
const MADRID_CENTER = { lat: 40.4168, lng: -3.7038 };
const nearbyCinemas = cinemas
  .map(cinema => ({
    cinema,
    distance: haversineDistance(MADRID_CENTER.lat, MADRID_CENTER.lng, cinema.latitude, cinema.longitude),
  }))
  .sort((a, b) => a.distance - b.distance)
  .slice(0, 4)
  .map(({ cinema, distance }) => {
    const sts = allShowtimesToday
      .filter(st => st.cinemaId === cinema.id)
      .sort((a, b) => a.time.localeCompare(b.time));
    const byMovie = new Map<string, typeof sts>();
    for (const st of sts) {
      const arr = byMovie.get(st.movieId) || [];
      arr.push(st);
      byMovie.set(st.movieId, arr);
    }
    const [featuredMovieId, featuredShowtimes] = [...byMovie.entries()].sort((a, b) => b[1].length - a[1].length)[0] || [];
    const featuredMovie = featuredMovieId ? movies.find(m => m.id === featuredMovieId) : undefined;
    return { cinema, distance, featuredMovie, showtimes: featuredShowtimes || [] };
  });
---

<Layout title="SmallParadiso" description="Busca una película o cuéntanos qué te apetece ver. SmallParadiso encuentra la película y la sesión por ti.">
  <div class="home">
    <!-- 01 · HERO -->
    <section class="hero">
      <div class="hero-bg-poster">
        <Poster title={heroMovie.title} color={heroMovie.posterColor} size="fill" bare />
      </div>
      <div class="hero-content">
        <p class="hero-eyebrow">Madrid · hoy, {today.toLocaleDateString('es-ES', { day: 'numeric', month: 'long' })}</p>
        <h1 class="hero-title">
          <span class="w1">¿Qué te</span>
          <span class="w2">apetece</span>
          <span class="w3 grad-text">ver hoy?</span>
        </h1>

        <div class="search-monument">
          <div class="search-field" id="search-field">
            <input
              type="text"
              placeholder="Una película, un plan, una obsesión…"
              id="main-search"
              autocomplete="off"
              aria-label="Buscar película o describir lo que quieres ver"
              aria-expanded="false"
              aria-controls="search-suggestions"
              aria-autocomplete="list"
              role="combobox"
            />
            <button type="button" class="btn-primary search-submit" id="search-go-btn">
              Buscar
              <svg class="arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
              <span class="wipe"></span>
            </button>
            <ul class="search-suggestions" id="search-suggestions" role="listbox" aria-label="Sugerencias"></ul>
          </div>
          <p class="understood"><span class="rd" aria-hidden="true"></span>"terror el sábado cerca de Chueca" → <b>Terror · Sábado · ~21:00 · Chueca</b></p>
        </div>

        <p class="prompts">
          Prueba: <a class="p1" href="/buscar?q=Algo%20parecido%20a%20The%20Substance">algo parecido a The Substance</a> ·
          <a class="p2" href="/buscar?q=Una%20pel%C3%ADcula%20para%20una%20primera%20cita">una primera cita</a>
        </p>
        <p class="hero-hint">¿Ya sabes el título? <button class="btn-text" id="title-search-link" type="button">Buscar por nombre →</button></p>
      </div>

      <div class="hero-credit">
        <span class="hero-tag">Selección SmallParadiso</span>
        <p><b>{heroMovie.title}</b> — {heroMovie.director}, {heroMovie.year}</p>
      </div>
    </section>

    <!-- 02 · DESCUBRIMIENTO -->
    <section class="mood">
      <SceneMarker num="02" label="Descubrimiento" />
      <div class="mood-inner">
        <p class="mood-label">¿No lo tienes claro?</p>
        <p class="mood-sentence">
          Dinos si te apetece algo <a class="mb" href="/buscar?q=Algo%20divertido">divertido</a>,
          <a class="ms" href="/buscar?q=Algo%20intenso">intenso</a>, romántico, que te haga
          <a class="mb" href="/buscar?q=Algo%20que%20me%20haga%20pensar">pensar</a>,
          <a class="ms" href="/buscar?q=Algo%20espectacular">espectacular</a> o directamente raro — y filtramos el resto.
        </p>
      </div>
    </section>

    <!-- 03 · AHORA EN CARTELERA -->
    {featuredPool.length > 0 && (
      <section class="bg-white">
        <SceneMarker num="03" label="Ahora en cartelera" />
        <div class="rail-feature">
          <div class="rf-copy">
            <p class="rf-kicker">Selección visual</p>
            <h2 class="rf-title">Lo que se puede ver esta noche en Madrid</h2>
            <p class="rf-sub">{featuredPool.length} películas distintas, actualizado con las sesiones reales de hoy.</p>
            <a class="btn-text" href="/buscar">Ver todas las salas →</a>
          </div>
          <div class="rf-content">
            <div class="rf-lead">
              <a href={`/pelicula/${leadMovie.slug}`} class="rf-lead-poster">
                <Poster title={leadMovie.title} genre={leadMovie.genres[0]} color={leadMovie.posterColor} />
              </a>
              <div class="rf-lead-text">
                <a href={`/pelicula/${leadMovie.slug}`} class="rf-lead-title">{leadMovie.title}</a>
                <p class="rf-lead-meta">{leadMovie.director.toUpperCase()} · {leadMovie.year}</p>
                <p class="rf-lead-blurb">{leadMovie.synopsis}</p>
              </div>
            </div>
            {stripMovies.length > 0 && (
              <div class="rail-scroll">
                <div class="rail-track">
                  {stripMovies.map(m => (
                    <PosterCard title={m.title} slug={m.slug} rating={m.rating} genre={m.genres[0]} posterColor={m.posterColor} />
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </section>
    )}

    <!-- 04 · UNA PELÍCULA PARA ESTA NOCHE -->
    <section class="spotlight">
      <div class="grain"></div>
      <SceneMarker num="04" label="Una película para esta noche" dark />
      <div class="spotlight-body-wrap">
        <div>
          <p class="spotlight-kicker">La crítica SmallParadiso</p>
          <h2 class="spotlight-title">{spotlightMovie.title}</h2>
          <p class="spotlight-body">{spotlightExcerpt}</p>
          <a class="btn-dark" href={`/pelicula/${spotlightMovie.slug}`}>
            Leer la crítica completa
            <svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            <span class="wipe"></span>
          </a>
        </div>
        <div class="spotlight-poster">
          <Poster title={spotlightMovie.title} genre={spotlightMovie.genres[0]} color={spotlightMovie.posterColor} />
        </div>
      </div>
    </section>

    <!-- 05 · ESTRENOS -->
    {newReleases.length > 0 && (
      <section class="slider-sec">
        <SceneMarker num="05" label="Estrenos" />
        <div class="slider-head">
          <div>
            <h2 class="slider-title">Recién llegadas a Madrid</h2>
            <p class="slider-sub">Lo nuevo, esta semana en cartelera.</p>
          </div>
          <div class="slider-nav">
            <button class="slider-arrow" type="button" data-dir="-1" data-target="estrenos-track" aria-label="Anterior">
              <span class="arrow-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="15 18 9 12 15 6"></polyline></svg></span>
              <span class="wipe"></span>
            </button>
            <button class="slider-arrow" type="button" data-dir="1" data-target="estrenos-track" aria-label="Siguiente">
              <span class="arrow-icon"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><polyline points="9 18 15 12 9 6"></polyline></svg></span>
              <span class="wipe"></span>
            </button>
          </div>
        </div>
        <div class="rail-scroll">
          <div class="rail-track slide-track" id="estrenos-track">
            {newReleases.map(m => (
              <PosterCard title={m.title} slug={m.slug} rating={m.rating} genre={m.genres[0]} posterColor={m.posterColor} size="lg" />
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 06 · ESTA SEMANA EN EL CINE -->
    <section class="editorial">
      <SceneMarker num="06" label="Esta semana en el cine" />
      <h2 class="ed-title">Tres cosas que están pasando en las salas de Madrid</h2>
      <div class="editorial-grid">
        {specialFormatMovie && specialFormatCinema && (
          <div class="ed-piece">
            <a href={`/pelicula/${specialFormatMovie.slug}`} class="ed-piece-poster">
              <Poster title={specialFormatMovie.title} color={specialFormatMovie.posterColor} bare />
            </a>
            <p class="ed-piece-kicker">Formato especial</p>
            <p class="ed-piece-quote"><a href={`/pelicula/${specialFormatMovie.slug}`}>{specialFormatMovie.title}</a> se proyecta hoy en <b>{specialFormatShowtime!.format}</b> en {specialFormatCinema.name}.</p>
            <p class="ed-piece-meta">Sesión de las {specialFormatShowtime!.time}.</p>
          </div>
        )}
        {taggedMovie && (
          <div class="ed-piece">
            <a href={`/pelicula/${taggedMovie.slug}`} class="ed-piece-poster">
              <Poster title={taggedMovie.title} color={taggedMovie.posterColor} bare />
            </a>
            <p class="ed-piece-kicker">Por qué verla</p>
            <p class="ed-piece-quote"><i>{taggedMovie.editorialTags[0].label}.</i></p>
            <p class="ed-piece-meta">Nuestra ficha de <a href={`/pelicula/${taggedMovie.slug}`}>{taggedMovie.title}</a>.</p>
          </div>
        )}
        {similarToSpotlight && (
          <div class="ed-piece">
            <a href={`/pelicula/${similarToSpotlight.slug}`} class="ed-piece-poster">
              <Poster title={similarToSpotlight.title} color={similarToSpotlight.posterColor} bare />
            </a>
            <p class="ed-piece-kicker">Si te gustó {spotlightMovie.title}</p>
            <p class="ed-piece-quote">Prueba <b>{similarToSpotlight.title}</b>.</p>
            <p class="ed-piece-meta">{similarToSpotlight.genres.join(' · ')}</p>
          </div>
        )}
      </div>
    </section>

    <!-- 07 · LE QUEDAN POCOS DÍAS -->
    {lastDays.length > 0 && (
      <section class="urgency">
        <SceneMarker num="07" label="Le quedan pocos días" />
        <div class="urgency-head">
          <h2 class="urgency-title">Si quieres verlas en pantalla grande, no las dejes pasar</h2>
        </div>
        <div class="rail-scroll">
          <div class="urgency-track">
            {lastDays.map(({ movie, daysLeft }) => (
              <a href={`/pelicula/${movie.slug}`} class="u-card">
                <Poster title={movie.title} color={movie.posterColor} bare />
                <p>{movie.title}</p>
                <span>{daysLeft === 1 ? 'Último día' : `${daysLeft} días`}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- 08 · CERCA DE TI -->
    {nearbyCinemas.length > 0 && (
      <section class="nearby">
        <SceneMarker num="08" label="Cerca de ti" />
        <div class="nearby-head">
          <h2 class="nearby-title">Lo que hay ahora mismo en el centro de Madrid</h2>
          <p class="nearby-sub">Cines ordenados por cercanía a Sol — cambia la ubicación cuando busques para ver la tuya.</p>
        </div>
        <div class="nearby-grid">
          {nearbyCinemas.map(({ cinema, distance, featuredMovie, showtimes }) => (
            <a href={`/cine/${cinema.slug}`} class="nb-cell">
              <p class="nb-dist">{distance.toFixed(1)} km</p>
              <p class="nb-name">{cinema.name}</p>
              <p class="nb-area">{cinema.neighborhood || cinema.city}</p>
              {featuredMovie ? (
                <>
                  <p class="nb-movie">{featuredMovie.title}</p>
                  <p class="nb-time">{showtimes.slice(0, 3).map(st => st.time).join(' · ')}</p>
                </>
              ) : (
                <p class="nb-time">Sin sesiones hoy</p>
              )}
            </a>
          ))}
        </div>
      </section>
    )}

    <!-- 09 · UNIVERSO SMALLPARADISO -->
    <section class="universe">
      <SceneMarker num="09" label="Universo SmallParadiso" />
      <div class="universe-row">
        <span class="universe-label">Próximamente</span>
        <div class="universe-links">
          <span>Guías de cine en Madrid</span>
          <span>Entrevistas</span>
          <span>Historias de sala</span>
        </div>
      </div>
    </section>
  </div>

  <script define:vars={{ moviesForSearch }}>
    window.__MOVIES__ = moviesForSearch;
  </script>

  <script>
    const searchField = document.getElementById('search-field') as HTMLDivElement;
    const input = document.getElementById('main-search') as HTMLInputElement;
    const suggestions = document.getElementById('search-suggestions') as HTMLUListElement;
    const goBtn = document.getElementById('search-go-btn') as HTMLButtonElement;
    let activeIndex = -1;
    let debounceTimer: ReturnType<typeof setTimeout>;

    function normalize(s: string) {
      return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    }

    function getMovies(): Array<{ title: string; slug: string; year?: number }> {
      return (window as any).__MOVIES__ || [];
    }

    function filterMovies(query: string) {
      if (!query || query.length < 2) return [];
      const q = normalize(query);
      return getMovies().filter(m => normalize(m.title).includes(q)).slice(0, 6);
    }

    function renderSuggestions(movies: Array<{ title: string; slug: string; year?: number }>) {
      if (movies.length === 0) {
        suggestions.innerHTML = '';
        suggestions.classList.remove('visible');
        input.setAttribute('aria-expanded', 'false');
        return;
      }

      suggestions.innerHTML = movies.map((m, i) => `
        <li role="option" id="suggestion-${i}" class="suggestion-item" data-slug="${m.slug}">
          <span class="suggestion-title">${m.title}</span>
          ${m.year ? `<span class="suggestion-year">${m.year}</span>` : ''}
        </li>
      `).join('');

      suggestions.classList.add('visible');
      input.setAttribute('aria-expanded', 'true');
      activeIndex = -1;

      suggestions.querySelectorAll('.suggestion-item').forEach(item => {
        item.addEventListener('click', () => {
          const slug = (item as HTMLElement).dataset.slug;
          window.location.href = `/buscar?pelicula=${slug}`;
        });
      });
    }

    function setActive(index: number) {
      const items = suggestions.querySelectorAll('.suggestion-item');
      items.forEach(el => el.classList.remove('active'));
      if (index >= 0 && index < items.length) {
        items[index].classList.add('active');
        items[index].scrollIntoView({ block: 'nearest' });
        input.setAttribute('aria-activedescendant', `suggestion-${index}`);
      } else {
        input.removeAttribute('aria-activedescendant');
      }
    }

    input.addEventListener('focus', () => searchField.classList.add('focused'));
    input.addEventListener('blur', () => searchField.classList.remove('focused'));

    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        renderSuggestions(filterMovies(input.value.trim()));
      }, 150);
    });

    input.addEventListener('keydown', (e) => {
      const items = suggestions.querySelectorAll('.suggestion-item');
      const count = items.length;

      if (e.key === 'ArrowDown' && count > 0) {
        e.preventDefault();
        activeIndex = (activeIndex + 1) % count;
        setActive(activeIndex);
      } else if (e.key === 'ArrowUp' && count > 0) {
        e.preventDefault();
        activeIndex = activeIndex <= 0 ? count - 1 : activeIndex - 1;
        setActive(activeIndex);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (activeIndex >= 0 && items[activeIndex]) {
          const slug = (items[activeIndex] as HTMLElement).dataset.slug;
          window.location.href = `/buscar?pelicula=${slug}`;
        } else {
          executeSearch();
        }
      } else if (e.key === 'Escape') {
        suggestions.classList.remove('visible');
        input.setAttribute('aria-expanded', 'false');
        activeIndex = -1;
      }
    });

    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('#search-field')) {
        suggestions.classList.remove('visible');
        input.setAttribute('aria-expanded', 'false');
      }
    });

    function executeSearch() {
      const query = input.value.trim();
      if (!query) return;

      const movies = getMovies();
      const exact = movies.find(m => normalize(m.title) === normalize(query));

      if (exact) {
        window.location.href = `/buscar?pelicula=${exact.slug}`;
      } else {
        window.location.href = `/buscar?q=${encodeURIComponent(query)}`;
      }
    }

    goBtn.addEventListener('click', executeSearch);

    const titleLink = document.getElementById('title-search-link');
    titleLink?.addEventListener('click', () => {
      input.focus();
      input.placeholder = 'Escribe el nombre de la película...';
    });

    document.querySelectorAll('.slider-arrow').forEach((btn) => {
      btn.addEventListener('click', () => {
        const dir = Number((btn as HTMLElement).dataset.dir || '1');
        const targetId = (btn as HTMLElement).dataset.target;
        const track = targetId ? document.getElementById(targetId) : null;
        track?.scrollBy({ left: dir * 280, behavior: 'smooth' });
      });
    });
  </script>
</Layout>

<style>
  .home {
    padding-bottom: var(--space-8);
  }

  /* ============ 01 · HERO — 95vh ============ */
  .hero {
    min-height: 95vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    position: relative;
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 64px var(--space-8) 40px;
  }

  .hero-bg-poster {
    position: absolute;
    top: 0; right: 0; bottom: 0;
    width: 44%;
    overflow: hidden;
    z-index: 0;
  }

  .hero-bg-poster::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, var(--color-bg) 0%, transparent 18%);
  }

  .hero-content {
    position: relative;
    z-index: 2;
    max-width: 760px;
