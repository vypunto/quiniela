---
import Layout from '../components/Layout.astro';
import PosterCard from '../components/PosterCard.astro';
import PosterRail from '../components/PosterRail.astro';
import Poster from '../components/Poster.astro';
import { getAllMovies, getShowtimes } from '../lib/search/searchEngine';

const movies = getAllMovies();
const moviesForSearch = movies.map(m => ({ title: m.title, slug: m.slug, year: m.year }));

const today = new Date();
const todayStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;

// Ahora en cartelera: movies that have showtimes today
const allShowtimes = getShowtimes({ date: todayStr });
const movieIdsWithShowings = new Set(allShowtimes.map(st => st.movieId));
const nowShowing = movies.filter(m => movieIdsWithShowings.has(m.id));

// Estrenos: movies with releaseDate in last 30 days
const thirtyDaysAgo = new Date(today);
thirtyDaysAgo.setDate(thirtyDaysAgo.getDate() - 30);
const thirtyDaysAgoStr = `${thirtyDaysAgo.getFullYear()}-${String(thirtyDaysAgo.getMonth() + 1).padStart(2, '0')}-${String(thirtyDaysAgo.getDate()).padStart(2, '0')}`;
const newReleases = movies
  .filter(m => m.releaseDate && m.releaseDate >= thirtyDaysAgoStr)
  .sort((a, b) => (b.releaseDate || '').localeCompare(a.releaseDate || ''));

// Le quedan pocos días: movies with few remaining showtime dates
const allFutureShowtimes = getShowtimes();
const movieLastDate = new Map<string, string>();
for (const st of allFutureShowtimes) {
  const current = movieLastDate.get(st.movieId);
  if (!current || st.date > current) {
    movieLastDate.set(st.movieId, st.date);
  }
}
const sevenDaysOut = new Date(today);
sevenDaysOut.setDate(sevenDaysOut.getDate() + 4);
const sevenDaysOutStr = `${sevenDaysOut.getFullYear()}-${String(sevenDaysOut.getMonth() + 1).padStart(2, '0')}-${String(sevenDaysOut.getDate()).padStart(2, '0')}`;
const lastDays = movies
  .filter(m => {
    const lastDate = movieLastDate.get(m.id);
    return lastDate && lastDate <= sevenDaysOutStr && lastDate >= todayStr;
  })
  .slice(0, 8);

// Hero pick: highest-rated movie currently showing
const heroMovie = [...(nowShowing.length ? nowShowing : movies)].sort((a, b) => b.rating - a.rating)[0];

// Featured rail: a lead movie (different from hero) + the rest of nowShowing as a strip
const featuredPool = nowShowing.length ? nowShowing : movies;
const leadMovie = featuredPool.find(m => m.id !== heroMovie.id) || featuredPool[0];
const stripMovies = featuredPool.filter(m => m.id !== leadMovie.id).slice(0, 8);

// Spotlight: best-reviewed movie, distinct from the hero pick
const reviewed = movies.filter(m => m.editorialReview && m.id !== heroMovie.id);
const spotlightMovie = [...reviewed].sort((a, b) => (b.editorialReview!.score) - (a.editorialReview!.score))[0] || heroMovie;
const spotlightExcerpt = spotlightMovie.editorialReview
  ? spotlightMovie.editorialReview.text.length > 200
    ? spotlightMovie.editorialReview.text.slice(0, 197).trimEnd() + '…'
    : spotlightMovie.editorialReview.text
  : spotlightMovie.synopsis.slice(0, 197).trimEnd() + '…';
---

<Layout title="SmallParadiso" description="Busca una película o cuéntanos qué te apetece ver. SmallParadiso encuentra la película y la sesión por ti.">
  <div class="home">
    <!-- HERO -->
    <section class="hero">
      <div class="hero-copy">
        <p class="hero-issue">Madrid · hoy, {today.toLocaleDateString('es-ES', { day: 'numeric', month: 'long' })}</p>
        <h1 class="hero-title">
          <span class="w1">¿Qué te</span>
          <span class="w2">apetece</span>
          <span class="w3 grad-text">ver?</span>
        </h1>
        <p class="hero-sub">Busca una película o cuéntanos qué estás buscando.</p>

        <div class="search-box" id="search-box">
          <svg class="icon" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
          <input
            type="text"
            placeholder="Una de terror para el sábado, sobre las nueve…"
            id="main-search"
            autocomplete="off"
            aria-label="Buscar película o describir lo que quieres ver"
            aria-expanded="false"
            aria-controls="search-suggestions"
            aria-autocomplete="list"
            role="combobox"
          />
          <button type="button" class="btn-primary search-submit" id="search-go-btn">
            Buscar
            <svg class="arrow" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            <span class="wipe"></span>
          </button>
          <ul class="search-suggestions" id="search-suggestions" role="listbox" aria-label="Sugerencias"></ul>
        </div>

        <p class="prompts">
          Prueba: <a class="p1" href="/buscar?q=Algo%20parecido%20a%20The%20Substance">algo parecido a The Substance</a> ·
          <a class="p2" href="/buscar?q=Una%20pel%C3%ADcula%20para%20una%20primera%20cita">una primera cita</a> ·
          <a class="p1" href="/buscar?q=Terror%20en%20VOSE%20cerca%20de%20Chueca">terror en VOSE cerca de Chueca</a>
        </p>

        <p class="hero-hint">¿Ya sabes el título? <button class="btn-text" id="title-search-link" type="button">Buscar por nombre →</button></p>
      </div>

      <div class="hero-frame">
        <Poster title={heroMovie.title} color={heroMovie.posterColor} size="fill" bare />
        <div class="hero-caption">
          <span class="hero-tag">Selección SmallParadiso</span>
          <p><b>{heroMovie.title}</b> — {heroMovie.director}, {heroMovie.year}</p>
        </div>
      </div>
    </section>

    <!-- ¿NO SABES QUÉ VER? -->
    <section class="mood">
      <p class="mood-label">¿No lo tienes claro?</p>
      <p class="mood-sentence">
        Dinos si te apetece algo <a class="mb" href="/buscar?q=Algo%20divertido">divertido</a>,
        <a class="ms" href="/buscar?q=Algo%20intenso">intenso</a>, romántico, que te haga
        <a class="mb" href="/buscar?q=Algo%20que%20me%20haga%20pensar">pensar</a>,
        <a class="ms" href="/buscar?q=Algo%20espectacular">espectacular</a> o directamente raro — y filtramos el resto.
      </p>
    </section>

    <!-- AHORA EN CARTELERA -->
    {featuredPool.length > 0 && (
      <section class="bg-white rail-feature">
        <div class="rf-copy">
          <p class="rf-kicker">Ahora en cartelera</p>
          <h2 class="rf-title">Lo que se puede ver esta noche en Madrid</h2>
          <p class="rf-sub">{featuredPool.length} películas distintas, actualizado con las sesiones reales de hoy.</p>
          <a class="btn-text" href="/buscar">Ver todas las salas →</a>
        </div>
        <div class="rf-content">
          <div class="rf-lead">
            <a href={`/pelicula/${leadMovie.slug}`} class="rf-lead-poster">
              <Poster title={leadMovie.title} genre={leadMovie.genres[0]} color={leadMovie.posterColor} />
            </a>
            <div class="rf-lead-text">
              <a href={`/pelicula/${leadMovie.slug}`} class="rf-lead-title">{leadMovie.title}</a>
              <p class="rf-lead-meta">{leadMovie.director.toUpperCase()} · {leadMovie.year}</p>
              <p class="rf-lead-blurb">{leadMovie.synopsis}</p>
            </div>
          </div>
          {stripMovies.length > 0 && (
            <div class="rail-scroll">
              <div class="rail-track">
                {stripMovies.map(m => (
                  <PosterCard title={m.title} slug={m.slug} rating={m.rating} genre={m.genres[0]} posterColor={m.posterColor} />
                ))}
              </div>
            </div>
          )}
        </div>
      </section>
    )}

    <!-- SPOTLIGHT — sección oscura -->
    <section class="spotlight">
      <div class="grain"></div>
      <div class="spotlight-inner">
        <div>
          <span class="mark" aria-hidden="true"></span>
          <p class="spotlight-kicker">Esta semana en pantalla grande</p>
          <h2 class="spotlight-title">{spotlightMovie.title}</h2>
          <p class="spotlight-body">{spotlightExcerpt}</p>
          <a class="btn-dark" href={`/pelicula/${spotlightMovie.slug}`}>
            Leer la crítica completa
            <svg class="arrow" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
            <span class="wipe"></span>
          </a>
        </div>
        <div class="spotlight-poster">
          <Poster title={spotlightMovie.title} genre={spotlightMovie.genres[0]} color={spotlightMovie.posterColor} />
        </div>
      </div>
    </section>

    <!-- ESTRENOS -->
    {newReleases.length > 0 && (
      <PosterRail title="Estrenos" subtitle="Lo nuevo que llega a los cines." bg="crema">
        {newReleases.map(m => (
          <PosterCard title={m.title} slug={m.slug} rating={m.rating} genre={m.genres[0]} posterColor={m.posterColor} />
        ))}
      </PosterRail>
    )}

    <!-- LE QUEDAN POCOS DÍAS -->
    {lastDays.length > 0 && (
      <PosterRail title="Le quedan pocos días" subtitle="Si quieres verla en pantalla grande, no la dejes pasar." bg="blanco">
        {lastDays.map(m => (
          <PosterCard title={m.title} slug={m.slug} rating={m.rating} genre={m.genres[0]} posterColor={m.posterColor} />
        ))}
      </PosterRail>
    )}
  </div>

  <script define:vars={{ moviesForSearch }}>
    window.__MOVIES__ = moviesForSearch;
  </script>

  <script>
    const searchBox = document.getElementById('search-box') as HTMLDivElement;
    const input = document.getElementById('main-search') as HTMLInputElement;
    const suggestions = document.getElementById('search-suggestions') as HTMLUListElement;
    const goBtn = document.getElementById('search-go-btn') as HTMLButtonElement;
    let activeIndex = -1;
    let debounceTimer: ReturnType<typeof setTimeout>;

    function normalize(s: string) {
      return s.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '');
    }

    function getMovies(): Array<{ title: string; slug: string; year?: number }> {
      return (window as any).__MOVIES__ || [];
    }

    function filterMovies(query: string) {
      if (!query || query.length < 2) return [];
      const q = normalize(query);
      return getMovies().filter(m => normalize(m.title).includes(q)).slice(0, 6);
    }

    function renderSuggestions(movies: Array<{ title: string; slug: string; year?: number }>) {
      if (movies.length === 0) {
        suggestions.innerHTML = '';
        suggestions.classList.remove('visible');
        input.setAttribute('aria-expanded', 'false');
        return;
      }

      suggestions.innerHTML = movies.map((m, i) => `
        <li role="option" id="suggestion-${i}" class="suggestion-item" data-slug="${m.slug}">
          <span class="suggestion-title">${m.title}</span>
          ${m.year ? `<span class="suggestion-year">${m.year}</span>` : ''}
        </li>
      `).join('');

      suggestions.classList.add('visible');
      input.setAttribute('aria-expanded', 'true');
      activeIndex = -1;

      suggestions.querySelectorAll('.suggestion-item').forEach(item => {
        item.addEventListener('click', () => {
          const slug = (item as HTMLElement).dataset.slug;
          window.location.href = `/buscar?pelicula=${slug}`;
        });
      });
    }

    function setActive(index: number) {
      const items = suggestions.querySelectorAll('.suggestion-item');
      items.forEach(el => el.classList.remove('active'));
      if (index >= 0 && index < items.length) {
        items[index].classList.add('active');
        items[index].scrollIntoView({ block: 'nearest' });
        input.setAttribute('aria-activedescendant', `suggestion-${index}`);
      } else {
        input.removeAttribute('aria-activedescendant');
      }
    }

    input.addEventListener('focus', () => searchBox.classList.add('focused'));
    input.addEventListener('blur', () => searchBox.classList.remove('focused'));

    input.addEventListener('input', () => {
      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => {
        renderSuggestions(filterMovies(input.value.trim()));
      }, 150);
    });

    input.addEventListener('keydown', (e) => {
      const items = suggestions.querySelectorAll('.suggestion-item');
      const count = items.length;

      if (e.key === 'ArrowDown' && count > 0) {
        e.preventDefault();
        activeIndex = (activeIndex + 1) % count;
        setActive(activeIndex);
      } else if (e.key === 'ArrowUp' && count > 0) {
        e.preventDefault();
        activeIndex = activeIndex <= 0 ? count - 1 : activeIndex - 1;
        setActive(activeIndex);
      } else if (e.key === 'Enter') {
        e.preventDefault();
        if (activeIndex >= 0 && items[activeIndex]) {
          const slug = (items[activeIndex] as HTMLElement).dataset.slug;
          window.location.href = `/buscar?pelicula=${slug}`;
        } else {
          executeSearch();
        }
      } else if (e.key === 'Escape') {
        suggestions.classList.remove('visible');
        input.setAttribute('aria-expanded', 'false');
        activeIndex = -1;
      }
    });

    document.addEventListener('click', (e) => {
      if (!(e.target as HTMLElement).closest('#search-box')) {
        suggestions.classList.remove('visible');
        input.setAttribute('aria-expanded', 'false');
      }
    });

    function executeSearch() {
      const query = input.value.trim();
      if (!query) return;

      const movies = getMovies();
      const exact = movies.find(m => normalize(m.title) === normalize(query));

      if (exact) {
        window.location.href = `/buscar?pelicula=${exact.slug}`;
      } else {
        window.location.href = `/buscar?q=${encodeURIComponent(query)}`;
      }
    }

    goBtn.addEventListener('click', executeSearch);

    const titleLink = document.getElementById('title-search-link');
    titleLink?.addEventListener('click', () => {
      input.focus();
      input.placeholder = 'Escribe el nombre de la película...';
    });
  </script>
</Layout>

<style>
  .home {
    padding-bottom: var(--space-8);
  }

  /* ============ HERO ============ */
  .hero {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .hero-copy {
    padding: var(--space-20) var(--space-12) var(--space-20) var(--space-8);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .hero-issue {
    font-size: .8rem;
    font-weight: 600;
    letter-spacing: .04em;
    color: var(--color-text-tertiary);
    text-transform: uppercase;
    margin-bottom: var(--space-6);
  }

  .hero-title {
    margin-bottom: var(--space-6);
  }

  .hero-title .w1 {
    display: block;
    font-weight: 400;
    font-size: clamp(2.3rem, 3.8vw, 3.4rem);
    line-height: 1.02;
    color: var(--color-text-secondary);
    letter-spacing: -0.01em;
  }

  .hero-title .w2 {
    display: block;
    font-weight: 800;
    font-size: clamp(2.5rem, 4.2vw, 3.9rem);
    line-height: .98;
    color: var(--color-text);
    letter-spacing: -0.03em;
  }

  .hero-title .w3 {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 460;
    font-size: clamp(3.3rem, 5.8vw, 5.4rem);
    line-height: .95;
    margin-top: 4px;
    letter-spacing: -0.02em;
  }

  .hero-sub {
    font-size: var(--text-lg);
    color: var(--color-text-secondary);
    max-width: 40ch;
    margin-bottom: var(--space-8);
  }

  /* SEARCH */
  .search-box {
    position: relative;
    display: flex;
    align-items: center;
    gap: var(--space-3);
    padding: 8px 8px 8px 24px;
    border: 2px solid var(--color-text);
    border-radius: 18px;
    background: var(--color-bg);
    margin-bottom: var(--space-6);
    overflow: hidden;
    transition: border-color .22s var(--ease-wipe);
  }

  .search-box::after {
    content: '';
    position: absolute;
    left: 0; bottom: -2px;
    height: 3px; width: 0%;
    background: var(--grad-brand);
    transition: width .28s var(--ease-wipe);
  }

  .search-box.focused {
    border-color: var(--color-burgundy);
  }

  .search-box.focused::after {
    width: 100%;
  }

  .search-box .icon {
    flex-shrink: 0;
    color: var(--color-text-tertiary);
  }

  .search-box input {
    flex: 1;
    min-width: 0;
    width: 100%;
    font-size: 1.18rem;
    font-weight: 500;
    color: var(--color-text);
    padding: var(--space-3) 0;
    transition: font-weight .2s ease;
  }

  .search-box.focused input {
    font-weight: 600;
  }

  .search-box input::placeholder {
    color: var(--color-text-tertiary);
    font-weight: 400;
  }

  .search-submit {
    flex-shrink: 0;
    border-radius: 11px;
    padding: 13px 20px;
    background: var(--color-text);
  }

  .search-submit .wipe {
    background: var(--color-burgundy);
  }

  .search-box.focused .search-submit {
    background: var(--color-accent);
  }

  .search-suggestions {
    position: absolute;
    top: calc(100% + var(--space-2));
    left: 0;
    right: 0;
    background-color: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-lg);
    max-height: 320px;
    overflow-y: auto;
    z-index: 50;
    opacity: 0;
    transform: translateY(-4px);
    pointer-events: none;
    transition: opacity var(--transition-fast), transform var(--transition-fast);
  }

  .search-suggestions.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  :global(.suggestion-item) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--space-3) var(--space-4);
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }

  :global(.suggestion-item:hover),
  :global(.suggestion-item.active) {
    background-color: var(--color-accent-subtle);
  }

  :global(.suggestion-title) {
    font-size: var(--text-base);
    font-weight: 600;
  }

  :global(.suggestion-year) {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    font-variant-numeric: tabular-nums;
  }

  .prompts {
    font-size: .92rem;
    font-weight: 500;
    line-height: 1.7;
    color: var(--color-text-tertiary);
    margin-bottom: var(--space-8);
  }

  .prompts .p1 {
    color: var(--color-text-secondary);
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition-fast);
  }

  .prompts .p2 {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    color: var(--color-accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color var(--transition-fast);
  }

  .prompts .p1:hover, .prompts .p2:hover {
    border-color: currentColor;
  }

  .hero-hint {
    font-size: var(--text-sm);
    color: var(--color-text-tertiary);
    margin-bottom: 0;
  }

  /* HERO POSTER PANEL */
  .hero-frame {
    position: relative;
  }

  .hero-caption {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    z-index: 2;
    padding: var(--space-6) var(--space-6) var(--space-5);
  }

  .hero-tag {
    display: inline-block;
    font-size: .68rem;
    font-weight: 700;
    letter-spacing: .06em;
    color: #fff;
    background: var(--grad-brand);
    padding: 5px 10px;
    border-radius: 4px;
    margin-bottom: var(--space-3);
    text-transform: uppercase;
  }

  .hero-caption p {
    font-size: .84rem;
    font-weight: 500;
    color: rgba(255,255,255,.85);
    margin-bottom: 0;
  }

  .hero-caption p b {
    font-weight: 700;
    color: #fff;
  }

  /* ============ MOOD ============ */
  .mood {
    max-width: var(--container-max);
    margin: 0 auto;
    border-top: 1px solid var(--color-border);
    padding: var(--space-14) var(--space-8) var(--space-16);
  }

  .mood-label {
    font-size: .8rem;
    font-weight: 700;
    letter-spacing: .04em;
    color: var(--color-accent);
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }

  .mood-sentence {
    font-size: 1.85rem;
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
    max-width: 32ch;
    color: var(--color-text);
    margin-bottom: 0;
  }

  .mood-sentence a {
    text-decoration: none;
    border-bottom: 2px solid var(--color-border);
    padding-bottom: 1px;
    transition: border-color var(--transition-fast);
  }

  .mood-sentence a:hover {
    border-color: var(--color-accent);
  }

  .mood-sentence a.mb {
    font-weight: 800;
    color: var(--color-text);
  }

  .mood-sentence a.ms {
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 500;
    color: var(--color-accent);
    border-bottom-color: transparent;
  }

  .mood-sentence a.ms:hover {
    border-bottom-color: var(--color-accent);
  }

  /* ============ FEATURED RAIL ============ */
  .rail-feature {
    padding: var(--space-16) var(--space-8);
    display: grid;
    grid-template-columns: 0.6fr 1.4fr;
    gap: var(--space-12);
    max-width: var(--container-max);
    margin: 0 auto;
  }

  .rail-feature > * {
    min-width: 0;
  }

  .rf-kicker {
    font-size: .82rem;
    font-weight: 700;
    letter-spacing: .02em;
    color: var(--color-accent);
    text-transform: uppercase;
    margin-bottom: var(--space-4);
  }

  .rf-title {
    font-size: clamp(2rem, 2.8vw, 2.7rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.06;
    margin-bottom: var(--space-4);
  }

  .rf-sub {
    font-size: var(--text-base);
    line-height: 1.55;
    color: var(--color-text-secondary);
    max-width: 32ch;
    margin-bottom: var(--space-5);
  }

  .rf-lead {
    display: grid;
    grid-template-columns: 250px 1fr;
    gap: var(--space-8);
